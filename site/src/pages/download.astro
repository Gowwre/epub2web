---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import release from "../data/latest-release.json";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  GUI_DOCS_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../consts";

function formatSize(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const published = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeZone: "UTC",
}).format(new Date(release.publishedAt));

const platforms = [
  {
    key: "windows",
    name: "Windows",
    label: "Windows x64",
    variant: "x64 installer",
    file: ".exe",
    hint: "Double-click the file to start the app.",
    icon: "windows",
    guide: "windows",
    download: release.downloads.windows,
  },
  {
    key: "macosArm64",
    name: "macOS",
    label: "macOS Apple Silicon",
    variant: "Apple Silicon",
    file: ".dmg",
    hint: "For most Macs made since late 2020.",
    icon: "apple",
    guide: "macos",
    download: release.downloads.macosArm64,
  },
  {
    key: "macosX64",
    name: "macOS",
    label: "macOS Intel",
    variant: "Intel",
    file: ".dmg",
    hint: "For older Macs.",
    icon: "apple",
    guide: "macos",
    download: release.downloads.macosX64,
  },
  {
    key: "linux",
    name: "Linux",
    label: "Linux x86_64",
    variant: "x86_64",
    file: ".AppImage",
    hint: "Make the file executable, then run it.",
    icon: "linux",
    guide: "linux",
    download: release.downloads.linux,
  },
] as const;

const firstLaunchGuides = {
  windows: {
    name: "Windows",
    icon: "windows",
    steps: [
      "Double-click the downloaded <code>.exe</code> file.",
      "If “Windows protected your PC” appears, click <strong>More info</strong>, then <strong>Run anyway</strong>.",
      "Choose your EPUB when the app opens.",
    ],
    note: "On a managed workplace or school PC, Smart App Control may block unsigned apps completely. Ask your administrator rather than disabling security features.",
  },
  macos: {
    name: "macOS",
    icon: "apple",
    steps: [
      "Open the <code>.dmg</code> and drag epub2web into <strong>Applications</strong>.",
      "Try to open the app once, then click <strong>Done</strong> when macOS blocks it.",
      "Open <strong>System Settings → Privacy &amp; Security</strong>, then click <strong>Open Anyway</strong> under Security and authenticate.",
      "Open the app again and choose your EPUB.",
    ],
    note: "On macOS 14 and earlier, right-click the app, choose Open, then Open again. The Open Anyway button is available for about an hour after the first attempt.",
  },
  linux: {
    name: "Linux",
    icon: "linux",
    steps: [
      "Make the AppImage executable: <code>chmod +x epub2web-gui-*.AppImage</code>.",
      "Run it: <code>./epub2web-gui-*.AppImage</code>.",
      "If FUSE is unavailable, run it with <code>--appimage-extract-and-run</code>.",
    ],
    note: "Linux doesn’t show a first-launch warning. You can verify the file against SHA256SUMS.txt before running it.",
  },
} as const;
---

<BaseLayout
  title="Download epub2web for Windows, macOS, and Linux"
  description="Download the epub2web desktop app for Windows, macOS, or Linux. Turn an EPUB into a reading website without installing Python."
  bodyClass="page-download"
>
  <section class="download-hero">
    <div class="container download-hero__grid">
      <div class="download-hero__copy">
        <p class="eyebrow">Download</p>
        <h1>
          Get the app.<br />
          <span>Open your book.</span>
        </h1>
        <p class="lede">
          Python and the fonts are already inside the download. Pick your
          computer below and open the file.
        </p>
        <div class="download-hero__actions">
          <a
            class="btn btn--primary btn--large"
            href="#platforms"
            data-download-primary
          >
            <span data-download-icon="direct" hidden>
              <Icon name="download" size={18} />
            </span>
            <span data-download-icon="choose">
              <Icon name="arrow-down" size={15} />
            </span>
            <span data-download-label>Choose your platform</span>
          </a>
          <a class="btn btn--quiet btn--large" href="#platforms" data-all-platforms hidden>
            All platforms
            <Icon name="arrow-down" size={15} />
          </a>
        </div>
        <p class="download-hero__meta">
          Version {release.version} · Direct file downloads · Windows, macOS,
          Linux · MIT licensed
        </p>
        <p
          class="download-hero__recommendation"
          data-download-recommendation
          aria-live="polite"
          hidden
        ></p>
      </div>

      <aside class="release-card" aria-label={`epub2web ${release.version} release information`}>
        <div class="release-card__head">
          <span class="release-card__status">
            <span class="release-card__dot" aria-hidden="true"></span>
            Latest release
          </span>
          <span class="release-card__source">
            <Icon name="github" size={13} />
            GitHub
          </span>
        </div>
        <p class="release-card__title">epub2web {release.version}</p>
        <p class="release-card__desc">
          The desktop app, ready to convert a book.
        </p>
        <dl class="release-card__specs">
          <div>
            <dt>Version</dt>
            <dd>{release.version}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>{published}</dd>
          </div>
          <div>
            <dt>Platforms</dt>
            <dd>Windows · macOS · Linux</dd>
          </div>
          <div>
            <dt>Install</dt>
            <dd>None</dd>
          </div>
        </dl>
        <a class="btn btn--quiet release-card__button" href={withBase("/changelog/")}>
          Release notes
          <Icon name="arrow-right" size={15} />
        </a>
        <p class="release-card__note">
          Every platform is listed below. Older versions are on the{" "}
          <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">releases page</a>.
        </p>
      </aside>
    </div>
  </section>

  <section class="section platforms" id="platforms" aria-labelledby="platforms-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your computer</p>
          <h2 id="platforms-title">Pick the download <span class="accent">for your computer.</span></h2>
        </div>
        <p class="lede">
          Each button starts the download from GitHub. If you're not sure which
          file you need, the note under each one should help.
        </p>
      </div>

      <div class="platform-grid">
        {
          platforms.map((platform) => (
            <a
              class="platform-card"
              href={platform.download.url}
              data-platform={platform.key}
              data-platform-label={platform.label}
              data-platform-guide={platform.guide}
              data-download-platform={platform.key}
              data-download-filename={platform.download.filename}
              data-download-size={formatSize(platform.download.size)}
              title={`${platform.download.filename} (${formatSize(platform.download.size)})`}
            >
              <span class="sr-only">Download epub2web for </span>
              <span class="platform-card__top">
                <span class="platform-card__icon">
                  <Icon name={platform.icon} size={20} />
                </span>
                <Icon name="download" size={16} class="platform-card__arrow" />
              </span>
              <span class="platform-card__badge" data-platform-badge hidden>
                Recommended
              </span>
              <h3>{platform.name}</h3>
              <p class="platform-card__variant">{platform.variant}</p>
              <p class="platform-card__file">
                {platform.file} · {formatSize(platform.download.size)}
              </p>
              <p class="platform-card__hint">{platform.hint}</p>
              <span class="sr-only">
                File: {platform.download.filename}. Download starts immediately.
              </span>
            </a>
          ))
        }
      </div>

      <p class="platforms__note">
        Linux AppImages may need to be made executable first: run{" "}
        <code>chmod +x epub2web-gui-*.AppImage</code>. If FUSE is unavailable, use{" "}
        <code>--appimage-extract-and-run</code>. Verify any file against{" "}
        <a href={release.checksums.url}>SHA256SUMS.txt</a>.
      </p>
    </div>
  </section>

  <section class="launch-warning" id="first-launch" aria-labelledby="launch-warning-title">
    <div class="container">
      <div class="launch-warning__intro">
        <div>
          <p class="eyebrow">Before you open it</p>
          <h2 id="launch-warning-title">The first-launch warning is expected.</h2>
        </div>
        <div>
          <p>
            The desktop builds don't have a paid code-signing certificate yet,
            so Windows SmartScreen and macOS Gatekeeper may warn that the
            developer can't be verified. That's expected. Only continue if you
            downloaded the file from the official GitHub release.
          </p>
          <a class="text-link" href={withBase("/#first-launch")}>
            Read the full first-launch FAQ
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="warning-grid">
        <article class="warning-card">
          <h3><Icon name="windows" size={17} /> On Windows</h3>
          <p>If “Windows protected your PC” appears:</p>
          <ol>
            <li>Click <strong>More info</strong>.</li>
            <li>Click <strong>Run anyway</strong>.</li>
            <li>Open the app and choose an EPUB.</li>
          </ol>
          <p class="warning-card__fine">
            On a managed workplace or school PC, Smart App Control may block
            unsigned apps completely. Ask your administrator rather than
            disabling security features.
          </p>
        </article>

        <article class="warning-card">
          <h3><Icon name="apple" size={17} /> On macOS</h3>
          <p>On macOS 15 and later, after dragging the app to Applications:</p>
          <ol>
            <li>Try to open it once, then click <strong>Done</strong>.</li>
            <li>Open <strong>System Settings → Privacy &amp; Security</strong>.</li>
            <li>Under <strong>Security</strong>, click <strong>Open Anyway</strong>.</li>
            <li>Authenticate, then open the app again.</li>
          </ol>
          <p class="warning-card__fine">
            On macOS 14 and earlier, right-click the app, choose{" "}
            <strong>Open</strong>, then click <strong>Open</strong> in the dialog.
            If macOS says the app is damaged, re-download it before trying the
            Terminal workaround.
          </p>
        </article>
      </div>

      <p class="launch-warning__fine">
        <Icon name="alert" size={15} />
        <span>
          Verify downloads against the{" "}
          <a href={release.checksums.url}>SHA256SUMS.txt</a>{" "}
          file. More detail is in the{" "}
          <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">README</a>{" "}
          and the <a href={GUI_DOCS_URL} target="_blank" rel="noopener noreferrer">desktop app docs</a>.
        </span>
      </p>
    </div>
  </section>

  <section class="section other-ways" aria-labelledby="other-ways-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Other ways to try it</p>
          <h2 id="other-ways-title">Prefer Python? <span class="accent">Or just looking?</span></h2>
        </div>
        <p class="lede">
          The desktop app is the simplest way to start. If you're comfortable
          with Python, you can install the package and run the converter from a
          terminal. Or try the demo first.
        </p>
      </div>

      <div class="other-ways__grid">
        <article class="other-card">
          <p class="eyebrow">From source</p>
          <h3>Install with pipx</h3>
          <p>
            epub2web needs Python 3.10 or newer. Install it from GitHub, then
            build and preview a book:
          </p>
          <pre class="install-code"><code>pipx install git+https://github.com/Gowwre/epub2web
epub2web book.epub --serve</code></pre>
          <a class="text-link" href={README_URL} target="_blank" rel="noopener noreferrer">
            Installation and CLI options
            <Icon name="arrow-up-right" size={14} class="icon--external" />
          </a>
        </article>

        <article class="other-card other-card--demo">
          <p class="eyebrow">Try it first</p>
          <h3>See a finished site.</h3>
          <p>
            The live demo is a complete epub2web site, built from a public-domain
            book and served as plain static files. Read a chapter, search it, try
            the dark theme.
          </p>
          <a
            class="btn btn--quiet"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the live demo
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </article>
      </div>

      <p class="other-ways__foot">
        Project source, issues, and release history live on{" "}
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>

  <dialog
    class="launch-dialog"
    data-launch-dialog
    aria-labelledby="launch-dialog-title"
    aria-describedby="launch-dialog-desc"
  >
    <div class="launch-dialog__inner">
      <button
        type="button"
        class="icon-btn launch-dialog__close"
        data-launch-dialog-close
        aria-label="Close the first-launch guide"
      >
        <Icon name="close" size={18} />
      </button>

      <p class="eyebrow launch-dialog__eyebrow">
        <span class="launch-dialog__status">
          <span class="launch-dialog__dot" aria-hidden="true"></span>
          Download started
        </span>
        <span class="launch-dialog__platform" data-launch-dialog-platform></span>
      </p>

      <h2 id="launch-dialog-title">Before you open it.</h2>
      <p class="launch-dialog__desc" id="launch-dialog-desc">
        Your download continues in the background. The app isn’t code-signed
        yet, so follow these steps the first time you open it on{" "}
        <strong data-launch-dialog-name>your computer</strong>.
      </p>

      <p class="launch-dialog__file">
        <span data-launch-dialog-filename></span>
        <span data-launch-dialog-size></span>
      </p>

      <div class="launch-dialog__guide">
        {
          Object.entries(firstLaunchGuides).map(([key, guide]) => (
            <div data-launch-guide={key} hidden>
              <h3>
                <Icon name={guide.icon} size={16} />
                On {guide.name}
              </h3>
              <ol>
                {guide.steps.map((step) => (
                  <li set:html={step}></li>
                ))}
              </ol>
              <p class="launch-dialog__note" set:html={guide.note}></p>
            </div>
          ))
        }
      </div>

      <p class="launch-dialog__verify">
        <Icon name="lock" size={14} />
        <span>
          Check the file against{" "}
          <a href={release.checksums.url}>SHA256SUMS.txt</a> if you want to verify it.
        </span>
      </p>

      <div class="launch-dialog__actions">
        <button type="button" class="btn btn--primary" data-launch-dialog-close>
          Got it
        </button>
        <a
          class="text-link"
          href="#first-launch"
          data-launch-dialog-guide-link
        >
          Full first-launch guide
          <Icon name="arrow-down" size={14} />
        </a>
      </div>
    </div>
  </dialog>

  <script>
    (async () => {
      interface UserAgentData {
        platform?: string;
        mobile?: boolean;
        getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }>;
      }

      const primary = document.querySelector<HTMLAnchorElement>("[data-download-primary]");
      const primaryLabel = document.querySelector<HTMLElement>("[data-download-label]");
      const directIcon = document.querySelector<HTMLElement>('[data-download-icon="direct"]');
      const chooseIcon = document.querySelector<HTMLElement>('[data-download-icon="choose"]');
      const recommendation = document.querySelector<HTMLElement>(
        "[data-download-recommendation]",
      );
      const allPlatforms = document.querySelector<HTMLElement>("[data-all-platforms]");
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-platform]"));
      const launchDialog = document.querySelector<HTMLDialogElement>("[data-launch-dialog]");
      const launchPlatform = document.querySelector<HTMLElement>("[data-launch-dialog-platform]");
      const launchName = document.querySelector<HTMLElement>("[data-launch-dialog-name]");
      const launchFilename = document.querySelector<HTMLElement>("[data-launch-dialog-filename]");
      const launchSize = document.querySelector<HTMLElement>("[data-launch-dialog-size]");
      const launchGuides = Array.from(
        document.querySelectorAll<HTMLElement>("[data-launch-guide]"),
      );
      const launchCloseButtons = Array.from(
        document.querySelectorAll<HTMLElement>("[data-launch-dialog-close]"),
      );
      const launchGuideLink = document.querySelector<HTMLElement>(
        "[data-launch-dialog-guide-link]",
      );

      const downloadDataAttributes = [
        "data-download-platform",
        "data-platform-guide",
        "data-platform-label",
        "data-download-filename",
        "data-download-size",
      ] as const;

      const copyDownloadData = (from: HTMLAnchorElement, to: HTMLAnchorElement) => {
        for (const attribute of downloadDataAttributes) {
          const value = from.getAttribute(attribute);
          if (value === null) {
            to.removeAttribute(attribute);
          } else {
            to.setAttribute(attribute, value);
          }
        }
      };

      const closeLaunchGuide = () => {
        if (!launchDialog?.open) return;
        launchDialog.close();
      };

      const openLaunchGuide = (link: HTMLAnchorElement) => {
        if (!launchDialog || typeof launchDialog.showModal !== "function") return;

        const guide = launchGuides.find(
          (candidate) => candidate.dataset.launchGuide === link.dataset.platformGuide,
        );
        if (!guide) return;

        for (const panel of launchGuides) panel.hidden = panel !== guide;

        const label = link.dataset.platformLabel ?? "your computer";
        if (launchPlatform) launchPlatform.textContent = label;
        if (launchName) launchName.textContent = label;
        if (launchFilename) launchFilename.textContent = link.dataset.downloadFilename ?? "";
        if (launchSize) launchSize.textContent = link.dataset.downloadSize ?? "";

        document.documentElement.classList.add("has-dialog-open");
        if (!launchDialog.open) launchDialog.showModal();
      };

      for (const button of launchCloseButtons) {
        button.addEventListener("click", closeLaunchGuide);
      }

      launchGuideLink?.addEventListener("click", closeLaunchGuide);

      launchDialog?.addEventListener("click", (event) => {
        if (event.target === launchDialog) closeLaunchGuide();
      });

      launchDialog?.addEventListener("close", () => {
        document.documentElement.classList.remove("has-dialog-open");
      });

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>("a[data-download-platform]");
        if (link) openLaunchGuide(link);
      });

      const announce = (message: string) => {
        if (!recommendation) return;
        recommendation.textContent = message;
        recommendation.hidden = false;
      };

      const clearRecommendedCard = () => {
        for (const card of cards) {
          card.classList.remove("platform-card--recommended");
          card
            .querySelector<HTMLElement>("[data-platform-badge]")
            ?.setAttribute("hidden", "");
        }
      };

      const choosePlatform = (message: string) => {
        clearRecommendedCard();
        if (!primary || !primaryLabel) return;
        primary.href = "#platforms";
        primaryLabel.textContent = "Choose your platform";
        for (const attribute of downloadDataAttributes) {
          primary.removeAttribute(attribute);
        }
        directIcon?.setAttribute("hidden", "");
        chooseIcon?.removeAttribute("hidden");
        allPlatforms?.setAttribute("hidden", "");
        announce(message);
      };

      const recommend = (key: string, message: string) => {
        const card = cards.find((candidate) => candidate.dataset.platform === key);
        if (!card || !primary || !primaryLabel) {
          choosePlatform("Choose the file that matches the computer you’ll use.");
          return;
        }

        clearRecommendedCard();
        card.classList.add("platform-card--recommended");
        card.querySelector<HTMLElement>("[data-platform-badge]")?.removeAttribute("hidden");
        primary.href = card.href;
        copyDownloadData(card, primary);
        primaryLabel.textContent = `Download for ${card.dataset.platformLabel}`;
        directIcon?.removeAttribute("hidden");
        chooseIcon?.setAttribute("hidden", "");
        allPlatforms?.removeAttribute("hidden");
        announce(message);
      };

      const ua = navigator.userAgent;
      const uaData = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData;
      const touchMac =
        navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1;
      const isMobile =
        uaData?.mobile === true || /iPhone|iPad|iPod|Android/i.test(ua) || touchMac;
      const isChromeOS = /CrOS/i.test(ua);
      const isWindows = /Windows NT/i.test(ua);
      const isMac = /Macintosh|Mac OS X/i.test(ua);
      const isLinux = !isChromeOS && /Linux/i.test(ua);
      const uaLooksArm = /aarch64|arm64|armv\d|armhf/i.test(ua);

      let architecture = "";
      try {
        architecture =
          (
            await uaData?.getHighEntropyValues?.(["architecture"])
          )?.architecture?.toLowerCase() ?? "";
      } catch {
        // High-entropy client hints are optional; fall back to the UA string.
      }

      if (isMobile) {
        choosePlatform("You’re on a phone or tablet. Choose the computer you’ll use.");
      } else if (isWindows) {
        recommend("windows", "Detected Windows. The x64 installer is selected.");
      } else if (isMac) {
        if (/x86|intel/i.test(architecture)) {
          recommend("macosX64", "Detected an Intel Mac. The Intel build is selected.");
        } else if (/arm/i.test(architecture)) {
          recommend("macosArm64", "Detected Apple Silicon. The arm64 build is selected.");
        } else {
          recommend(
            "macosArm64",
            "Most Macs use Apple Silicon. Choose Intel below if yours is older.",
          );
        }
      } else if (isChromeOS) {
        choosePlatform("ChromeOS detected. Choose the computer you’ll use.");
      } else if (isLinux) {
        if (/arm/i.test(architecture) || uaLooksArm) {
          choosePlatform("This release is for x86_64 Linux; ARM Linux isn’t available yet.");
        } else {
          recommend("linux", "Detected Linux. The x86_64 AppImage is selected.");
        }
      } else {
        choosePlatform("Choose the file that matches the computer you’ll use.");
      }
    })();
  </script>
</BaseLayout>

<style>
  .download-hero {
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .download-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .download-hero h1 {
    margin-top: 0.25rem;
    font-size: clamp(3.3rem, 2.2rem + 4vw, 5.5rem);
    line-height: 0.91;
    letter-spacing: -0.055em;
    font-variation-settings: "opsz" 100, "SOFT" 35, "WONK" 0;
  }

  .download-hero h1 span {
    color: var(--accent);
  }

  .download-hero .lede {
    margin: 1.5rem 0 1.9rem;
  }

  .download-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .download-hero__meta {
    margin: 1.3rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .download-hero__recommendation {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.69rem;
    line-height: 1.55;
    color: var(--accent);
  }

  .download-hero__recommendation::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--accent);
  }

  .release-card {
    position: relative;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--paper-2);
    box-shadow: var(--shadow-deep);
    transform: rotate(0.6deg);
