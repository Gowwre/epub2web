---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import release from "../data/latest-release.json";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  GUI_DOCS_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../consts";

function formatSize(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const published = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeZone: "UTC",
}).format(new Date(release.publishedAt));

const platforms = [
  {
    name: "Windows",
    variant: "x64 installer",
    file: ".exe",
    hint: "Double-click to start.",
    icon: "windows",
    download: release.downloads.windows,
  },
  {
    name: "macOS",
    variant: "Apple Silicon",
    file: ".dmg",
    hint: "Most Macs since late 2020.",
    icon: "apple",
    download: release.downloads.macosArm64,
  },
  {
    name: "macOS",
    variant: "Intel",
    file: ".dmg",
    hint: "For older Macs.",
    icon: "apple",
    download: release.downloads.macosX64,
  },
  {
    name: "Linux",
    variant: "x86_64",
    file: ".AppImage",
    hint: "Make executable, then run.",
    icon: "terminal",
    download: release.downloads.linux,
  },
] as const;
---

<BaseLayout
  title="Download epub2web — Windows, macOS, and Linux"
  description="Download the epub2web desktop app directly from GitHub. A self-contained EPUB-to-website converter for Windows, macOS, and Linux."
  bodyClass="page-download"
>
  <section class="download-hero">
    <div class="container download-hero__grid">
      <div class="download-hero__copy">
        <p class="eyebrow">Download</p>
        <h1>
          One download.<br />
          <span>No setup.</span>
        </h1>
        <p class="lede">
          The desktop app bundles Python, Tkinter, the converter, the reader
          theme, and the fonts. Choose your platform, open the file, and turn an
          EPUB into a reading website.
        </p>
        <div class="download-hero__actions">
          <a class="btn btn--primary btn--large" href={release.downloads.windows.url}>
            <Icon name="download" size={18} />
            Download for Windows
          </a>
          <a class="btn btn--quiet btn--large" href="#platforms">
            All platforms
            <Icon name="arrow-down" size={15} />
          </a>
        </div>
        <p class="download-hero__meta">
          Version {release.version} · Direct file downloads · Windows, macOS,
          Linux · MIT licensed
        </p>
      </div>

      <aside class="release-card" aria-label={`epub2web ${release.version} release information`}>
        <div class="release-card__head">
          <span class="release-card__status">
            <span class="release-card__dot" aria-hidden="true"></span>
            Latest release
          </span>
          <span class="release-card__source">
            <Icon name="github" size={13} />
            GitHub
          </span>
        </div>
        <p class="release-card__title">epub2web {release.version}</p>
        <p class="release-card__desc">
          A self-contained build of the converter and desktop interface.
        </p>
        <dl class="release-card__specs">
          <div>
            <dt>Version</dt>
            <dd>{release.version}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>{published}</dd>
          </div>
          <div>
            <dt>Platforms</dt>
            <dd>Windows · macOS · Linux</dd>
          </div>
          <div>
            <dt>Install</dt>
            <dd>None</dd>
          </div>
        </dl>
        <a
          class="btn btn--quiet release-card__button"
          href={release.releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Release notes
          <Icon name="arrow-up-right" size={15} />
        </a>
        <p class="release-card__note">
          Direct download links for every platform are below.{" "}
          <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">All releases</a>.
        </p>
      </aside>
    </div>
  </section>

  <section class="section platforms" id="platforms" aria-labelledby="platforms-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your computer</p>
          <h2 id="platforms-title">Four files, <span class="accent">ready to download.</span></h2>
        </div>
        <p class="lede">
          Every button downloads the matching installer directly from GitHub. No
          release page in between; version numbers are in the filenames.
        </p>
      </div>

      <div class="platform-grid">
        {
          platforms.map((platform) => (
            <a
              class="platform-card"
              href={platform.download.url}
              title={`${platform.download.filename} (${formatSize(platform.download.size)})`}
            >
              <span class="sr-only">Download epub2web for </span>
              <span class="platform-card__top">
                <span class="platform-card__icon">
                  <Icon name={platform.icon} size={20} />
                </span>
                <Icon name="download" size={16} class="platform-card__arrow" />
              </span>
              <h3>{platform.name}</h3>
              <p class="platform-card__variant">{platform.variant}</p>
              <p class="platform-card__file">
                {platform.file} · {formatSize(platform.download.size)}
              </p>
              <p class="platform-card__hint">{platform.hint}</p>
              <span class="sr-only">
                File: {platform.download.filename}. Download starts immediately.
              </span>
            </a>
          ))
        }
      </div>

      <p class="platforms__note">
        Linux AppImages may need to be made executable first: run{" "}
        <code>chmod +x epub2web-gui-*.AppImage</code>. If FUSE is unavailable, use{" "}
        <code>--appimage-extract-and-run</code>. Verify any file against{" "}
        <a href={release.checksums.url}>SHA256SUMS.txt</a>.
      </p>
    </div>
  </section>

  <section class="launch-warning" id="first-launch" aria-labelledby="launch-warning-title">
    <div class="container">
      <div class="launch-warning__intro">
        <div>
          <p class="eyebrow">Before you open it</p>
          <h2 id="launch-warning-title">The first-launch warning is expected.</h2>
        </div>
        <div>
          <p>
            The desktop builds do not have paid code-signing certificates yet,
            so Windows SmartScreen and macOS Gatekeeper may say the developer
            cannot be verified. That is expected — but only continue if you
            downloaded the file from the official GitHub release.
          </p>
          <a class="text-link" href={withBase("/#first-launch")}>
            Read the full first-launch FAQ
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="warning-grid">
        <article class="warning-card">
          <h3><Icon name="windows" size={17} /> On Windows</h3>
          <p>If “Windows protected your PC” appears:</p>
          <ol>
            <li>Click <strong>More info</strong>.</li>
            <li>Click <strong>Run anyway</strong>.</li>
            <li>Open the app and choose an EPUB.</li>
          </ol>
          <p class="warning-card__fine">
            On a managed workplace or school PC, Smart App Control may block
            unsigned apps completely. Ask your administrator rather than
            disabling security features.
          </p>
        </article>

        <article class="warning-card">
          <h3><Icon name="apple" size={17} /> On macOS</h3>
          <p>On macOS 15 and later, after dragging the app to Applications:</p>
          <ol>
            <li>Try to open it once, then click <strong>Done</strong>.</li>
            <li>Open <strong>System Settings → Privacy &amp; Security</strong>.</li>
            <li>Under <strong>Security</strong>, click <strong>Open Anyway</strong>.</li>
            <li>Authenticate, then open the app again.</li>
          </ol>
          <p class="warning-card__fine">
            On macOS 14 and earlier, right-click the app, choose{" "}
            <strong>Open</strong>, then click <strong>Open</strong> in the dialog.
            If macOS says the app is damaged, re-download it before trying the
            Terminal workaround.
          </p>
        </article>
      </div>

      <p class="launch-warning__fine">
        <Icon name="alert" size={15} />
        <span>
          Verify downloads against the{" "}
          <a href={release.checksums.url}>SHA256SUMS.txt</a>{" "}
          file. More detail is in the{" "}
          <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">README</a>{" "}
          and the <a href={GUI_DOCS_URL} target="_blank" rel="noopener noreferrer">desktop app docs</a>.
        </span>
      </p>
    </div>
  </section>

  <section class="section other-ways" aria-labelledby="other-ways-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Other ways to run it</p>
          <h2 id="other-ways-title">Source or demo. <span class="accent">Your choice.</span></h2>
        </div>
        <p class="lede">
          The desktop app is the easiest route. The Python package and the live
          demo are there for anyone who wants to look under the cover first.
        </p>
      </div>

      <div class="other-ways__grid">
        <article class="other-card">
          <p class="eyebrow">From source</p>
          <h3>Prefer Python?</h3>
          <p>
            epub2web needs Python 3.10 or newer. Install it from GitHub for now,
            then build and preview a book:
          </p>
          <pre class="install-code"><code>pipx install git+https://github.com/Gowwre/epub2web
epub2web book.epub --serve</code></pre>
          <a class="text-link" href={README_URL} target="_blank" rel="noopener noreferrer">
            Installation and CLI options
            <Icon name="arrow-up-right" size={14} class="icon--external" />
          </a>
        </article>

        <article class="other-card other-card--demo">
          <p class="eyebrow">No install</p>
          <h3>See a finished edition.</h3>
          <p>
            The live demo is a complete epub2web site, built from a public-domain
            book and hosted as plain static files. Read a chapter, search it, try
            the dark theme.
          </p>
          <a
            class="btn btn--quiet"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the live demo
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </article>
      </div>

      <p class="other-ways__foot">
        Project source, issues, and release history live on{" "}
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .download-hero {
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .download-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .download-hero h1 {
    margin-top: 0.25rem;
    font-size: clamp(3.3rem, 2.2rem + 4vw, 5.5rem);
    line-height: 0.91;
    letter-spacing: -0.055em;
    font-variation-settings: "opsz" 100, "SOFT" 35, "WONK" 0;
  }

  .download-hero h1 span {
    color: var(--accent);
  }

  .download-hero .lede {
    margin: 1.5rem 0 1.9rem;
  }

  .download-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .download-hero__meta {
    margin: 1.3rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .release-card {
    position: relative;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--paper-2);
    box-shadow: var(--shadow-deep);
    transform: rotate(0.6deg);
  }

  .release-card::before {
    content: "";
    position: absolute;
    inset: 8px -8px -8px 8px;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 4px;
  }

  .release-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .release-card__status,
  .release-card__source {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .release-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .release-card__title {
    margin: 1.1rem 0 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.95rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .release-card__desc {
    margin: 0;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  .release-card__specs {
    margin: 1rem 0 1.1rem;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .release-card__specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.7rem;
  }

  .release-card__specs dt {
    color: var(--muted);
  }

  .release-card__specs dd {
    margin: 0;
    color: var(--ink-2);
    text-align: right;
  }

  .release-card__button {
    width: 100%;
  }

  .release-card__note {
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.64rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }

  .platforms {
    background: var(--paper-2);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.2rem, 4.5vw, 3.8rem);
  }

  .section-heading h2 {
    margin-top: 0.15rem;
    font-size: clamp(2.25rem, 1.55rem + 2.8vw, 4.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .accent {
    color: var(--accent);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    min-height: 220px;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .platform-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--rule));
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .platform-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.7rem;
  }

  .platform-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--accent);
  }

  .platform-card__arrow {
    color: var(--muted);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .platform-card:hover .platform-card__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .platform-card h3 {
    margin-bottom: 0.1rem;
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .platform-card__variant {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.69rem;
    color: var(--ink-2);
  }

  .platform-card__file {
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent);
  }

  .platform-card__hint {
    margin: auto 0 0;
    padding-top: 1.2rem;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .platforms__note {
    margin: 1.3rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .platforms__note code {
    padding: 0.08em 0.28em;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
    font-size: 0.92em;
  }

  .launch-warning {
    padding-block: clamp(3.8rem, 7vw, 6.5rem);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .launch-warning__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .launch-warning h2 {
    margin-top: 0.15rem;
    font-size: clamp(2.15rem, 1.6rem + 2.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .launch-warning__intro > div:last-child p {
    max-width: 54ch;
    margin: 0 0 0.8rem;
    font-size: 0.93rem;
    color: var(--ink-2);
  }

  .warning-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .warning-card {
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--rule);
    border-top: 2px solid color-mix(in srgb, var(--accent) 55%, var(--rule));
    border-radius: 4px;
    background: var(--paper-2);
  }

  .warning-card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .warning-card h3 .icon {
    color: var(--accent);
  }

  .warning-card p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--ink-2);
  }

  .warning-card ol {
    display: grid;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .warning-card__fine {
    margin-top: 0.8rem !important;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
    font-size: 0.74rem !important;
    line-height: 1.55;
    color: var(--muted) !important;
  }

  .launch-warning__fine {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .launch-warning__fine .icon {
    margin-top: 0.12rem;
    color: var(--accent);
  }

  .launch-warning__fine a {
    color: var(--accent);
  }

  .other-ways {
    border-top: 1px solid var(--rule);
  }

  .other-ways__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .other-card {
    min-width: 0;
    padding: clamp(1.3rem, 2.5vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-2);
  }

  .other-card h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .other-card > p:not(.eyebrow) {
    max-width: 52ch;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .install-code {
    margin: 1rem 0 1.1rem;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-3);
    font-size: 0.69rem;
    line-height: 1.9;
    color: var(--ink-2);
  }

  .other-card--demo .btn {
    margin-top: 0.4rem;
  }

  .other-ways__foot {
    margin: 1.5rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--muted);
  }

  @media (max-width: 1050px) {
    .download-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
      gap: 2.7rem;
    }

    .platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .download-hero__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 7vw, 4rem);
    }

    .download-hero__copy {
      max-width: 640px;
    }

    .release-card {
      max-width: 480px;
      width: 100%;
      transform: none;
    }

    .section-heading,
    .launch-warning__intro {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      align-items: start;
    }

    .download-hero__actions {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 680px) {
    .warning-grid,
    .other-ways__grid {
      grid-template-columns: 1fr;
    }

    .install-code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .download-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .download-hero__actions .btn {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .platform-grid {
      grid-template-columns: 1fr;
    }

    .platform-card {
      min-height: 190px;
    }

    .platform-card__top {
      margin-bottom: 1.3rem;
    }
  }
</style>
