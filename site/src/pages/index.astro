---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  ISSUES_URL,
  LATEST_RELEASE_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../consts";

const home720 = withBase("/screenshots/home-720.webp");
const home1440 = withBase("/screenshots/home-1440.webp");
const reading720 = withBase("/screenshots/reading-720.webp");
const reading1440 = withBase("/screenshots/reading-1440.webp");
const searchPanel = withBase("/screenshots/search-panel.webp");

const fidelityChecks = [
  {
    label: "Text",
    body: "Every reading page is compared with the EPUB it came from. A dropped sentence, changed punctuation, or moved paragraph stops the build.",
  },
  {
    label: "Images",
    body: "Each figure is counted and checked against the source. A missing image fails the build instead of publishing a hole in the book.",
  },
  {
    label: "Links",
    body: "Internal links, anchors, images, and duplicate IDs are checked before anything is published. Readers do not hit a dead end between chapters.",
  },
];

const faqs = [
  {
    question: "Is my book uploaded anywhere?",
    answer:
      "No. The EPUB is read on your computer, the site is built there, and the finished folder stays there. There is no account and no upload step. If you publish it, that is your choice.",
  },
  {
    question: "Will the text be changed?",
    answer:
      "No. The words and punctuation stay as they are. epub2web may change how the book looks, but not what it says. A fidelity gate compares every page with the source and stops the build if anything is missing.",
  },
  {
    question: "What exactly do I get?",
    answer:
      "A folder with a cover, a table of contents, a page for each chapter, images, fonts, and a search index. It includes a small reading theme that works on phones and desktops. Standard EPUB 2 and EPUB 3 books work best; DRM-protected and fixed-layout books may not.",
  },
  {
    question: "Can I highlight passages and take notes?",
    answer:
      "Yes. Select text to highlight it in one action, add a private note when you want one, and find every mark in the Highlights & notes panel. Copy them as Markdown or export a JSON backup. Everything stays in your browser and is never added to the published site.",
  },
  {
    question: "Do highlights and notes sync between devices?",
    answer:
      "Not automatically. They live in the browser that created them. Use Copy all or Export to move them, and keep a backup before clearing site data. The reader only asks for persistent storage after you choose Keep on this device.",
  },
  {
    question: "Can I put the site online, or read it later?",
    answer:
      "Yes. The output is a plain static folder, so it works on GitHub Pages, Cloudflare Pages, Netlify, S3, nginx, or any static host. To read it later on your own computer, reopen the app and press Convert, or serve the folder with any local static server. Subpath hosting is supported with the command-line --base-path option.",
  },
  {
    question: "What if my book does not convert?",
    answer:
      "epub2web stops instead of dropping content, leaves any previous working site untouched, and creates a support ZIP you can attach to a GitHub issue. Do not attach the book itself. The ZIP can contain file paths, metadata, and short excerpts, so look through it first.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <a class="launch-pill" href="#annotations">
          <span class="launch-pill__new">New</span>
          <span>Highlights &amp; notes</span>
          <Icon name="arrow-right" size={13} class="launch-pill__arrow" />
        </a>

        <h1>
          Turn an EPUB<br />
          into a <span class="accent">website.</span>
        </h1>

        <p class="hero__intro">
          A reading website built from the EPUB you own. The text and images
          survive intact, search and highlights are built in, and the finished
          folder is yours to keep or publish.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary btn--large" href={withBase("/download/")}>
            <Icon name="download" size={17} />
            Download the app
          </a>
          <a
            class="btn btn--quiet btn--large"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the live demo
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </div>

        <ul class="hero__meta" aria-label="At a glance">
          <li>Free &amp; open source</li>
          <li>Windows · macOS · Linux</li>
          <li>No account · No upload</li>
        </ul>
      </div>

      <figure class="hero__visual">
        <div class="shot">
          <img
            src={home1440}
            srcset={`${home720} 720w, ${home1440} 1440w`}
            sizes="(max-width: 980px) 100vw, 46vw"
            width="1440"
            height="1000"
            alt="The epub2web reader home page for Alice's Adventures in Wonderland, showing the cover, title, author, and Start reading button."
            fetchpriority="high"
          />
        </div>
        <figcaption class="shot-caption">
          Alice's Adventures in Wonderland, built from EPUB.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section fidelity" id="fidelity">
    <div class="container">
      <div class="fidelity__grid">
        <div class="fidelity__copy">
          <p class="eyebrow">Fidelity</p>
          <h2>
            The layout changes.<br />
            <span class="accent">The words don't.</span>
          </h2>
          <p class="lede">
            epub2web compares the finished site with the EPUB it came from. If
            text, images, or links do not survive the conversion, the build
            stops instead of publishing a damaged book.
          </p>

          <ul class="fidelity__checks">
            {
              fidelityChecks.map((check) => (
                <li>
                  <span class="fidelity__check-label">
                    <Icon name="check" size={13} />
                    {check.label}
                  </span>
                  <p>{check.body}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="colophon">
          <div class="colophon__head">
            <div>
              <p class="colophon__kicker">Colophon</p>
              <h3>A real build</h3>
            </div>
            <span class="status">
              <Icon name="check" size={13} />
              Verified
            </span>
          </div>

          <dl class="colophon__rows">
            <div class="colophon__row">
              <dt>Source</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>alice.epub</dd>
            </div>
            <div class="colophon__row">
              <dt>Words</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>29,564</dd>
            </div>
            <div class="colophon__row">
              <dt>Pages</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>13 / 13 match</dd>
            </div>
            <div class="colophon__row">
              <dt>Images</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>12 / 12 present</dd>
            </div>
            <div class="colophon__row">
              <dt>Links</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>743 checked · 0 broken</dd>
            </div>
            <div class="colophon__row">
              <dt>Uploads</dt>
              <span class="colophon__dots" aria-hidden="true"></span>
              <dd>None</dd>
            </div>
          </dl>

          <figcaption>Generated locally in 0.57 seconds. Nothing was uploaded.</figcaption>
        </figure>
      </div>

      <p class="fidelity__failnote">
        <Icon name="shield" size={16} />
        <span>
          <strong>If a check fails, the build stops.</strong> Your previous site
          stays exactly where it was, and the error report tells you what did not
          match.
        </span>
      </p>
    </div>
  </section>

  <section class="section edition" id="features">
    <div class="container">
      <header class="section-intro">
        <p class="eyebrow">The reading site</p>
        <h2>
          A book, not a<br />
          <span class="accent">dump of HTML.</span>
        </h2>
        <p class="lede">
          You get a cover, a table of contents, a page for each chapter, the
          pictures, footnotes, search, and a private layer for highlights and
          notes. It is all one static folder you can keep or publish.
        </p>
      </header>

      <div class="feature-grid">
        <article class="feature feature--reading">
          <h3>Reads like a book</h3>
          <p>
            Comfortable type, adjustable size and spacing, light and dark
            themes, and a place marker that remembers where you stopped.
          </p>
          <figure class="feature__media">
            <img
              src={reading1440}
              srcset={`${reading720} 720w, ${reading1440} 1440w`}
              sizes="(max-width: 980px) 100vw, 56vw"
              width="1440"
              height="1000"
              alt="The reading view: a chapter of Alice's Adventures in Wonderland with a contents sidebar, progress line, and comfortable serif typography."
              loading="lazy"
            />
            <figcaption class="feature__media-caption">The reading view</figcaption>
          </figure>
        </article>

        <article class="feature feature--search">
          <h3>Search the whole book</h3>
          <p>
            The book is indexed when the site is built. Search for a word and
            jump straight to it; no search service and no account.
          </p>
          <figure class="feature__media">
            <img
              src={searchPanel}
              width="640"
              height="480"
              alt="The built-in search panel showing highlighted results for the word rabbit across chapters."
              loading="lazy"
            />
            <figcaption class="feature__media-caption">Search results</figcaption>
          </figure>
        </article>

        <article class="feature feature--file">
          <Icon name="folder" size={21} />
          <h3>Yours to keep</h3>
          <p>
            One folder of HTML, CSS, images, fonts, and search data. Put it on
            any static host, or keep it on your computer.
          </p>
          <pre class="file-tree"><code><span class="tree-root">book-site/</span>
├── <span class="tree-file">index.html</span>
├── <span class="tree-file">read/1/index.html</span>
├── <span class="tree-dir">assets/</span>
└── <span class="tree-file">search-index.json</span></code></pre>
        </article>

        <article class="feature feature--book">
          <Icon name="book" size={21} />
          <h3>The whole book comes along</h3>
          <p>
            Pictures with captions, tables, lists, footnotes, and
            cross-references all survive the move.
          </p>
          <ul class="tag-list">
            <li>Figures</li>
            <li>Tables</li>
            <li>Footnotes</li>
            <li>Cross-references</li>
          </ul>
        </article>

        <article class="feature feature--a11y">
          <Icon name="keyboard" size={21} />
          <h3>Works for more readers</h3>
          <p>
            Keyboard navigation, clear labels, and image descriptions are part
            of the reader, not an afterthought.
          </p>
          <ul class="tag-list">
            <li>Keyboard</li>
            <li>Labels</li>
            <li>Alt text</li>
          </ul>
        </article>
      </div>

      <p class="edition__link">
        <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Open the live demo
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="section annotations" id="annotations">
    <div class="container annotations__grid">
      <div class="annotations__copy">
        <p class="eyebrow">Highlights &amp; notes</p>
        <h2>
          Read with a<br />
          <span class="accent">pencil in hand.</span>
        </h2>
        <p class="lede">
          Select a passage to highlight it. Add a private note when you want
          one. Everything stays in your browser and is never written into the
          published site.
        </p>

        <ul class="annotation-points">
          <li>
            <Icon name="highlighter" size={18} />
            <div>
              <h3>Highlight in one action</h3>
              <p>
                Select text and highlight it in your last-used color. A note is
                optional, never a required second step.
              </p>
            </div>
          </li>
          <li>
            <Icon name="search" size={18} />
            <div>
              <h3>Find every mark</h3>
              <p>
                Review by chapter, search by quote or note, and jump back to the
                passage in one click.
              </p>
            </div>
          </li>
          <li>
            <Icon name="download" size={18} />
            <div>
              <h3>Take it with you</h3>
              <p>
                Copy everything as Markdown, export a readable file, or keep a
                JSON backup. The marks never enter the site itself.
              </p>
            </div>
          </li>
        </ul>

        <p class="annotations__more">
          <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
            Try highlights in the live demo
            <Icon name="arrow-up-right" size={14} class="icon--external" />
          </a>
        </p>
      </div>

      <figure class="annotation-demo">
        <div class="annotation-demo__stage">
          <div class="annotation-demo__page">
            <p class="annotation-demo__kicker">Chapter I</p>
            <h3>Down the Rabbit-Hole</h3>
            <p class="annotation-demo__text">
              Alice was beginning to get very tired of sitting by her sister on
              the bank, and of having nothing to do: <mark>once or twice she had
              peeped into the book her sister was reading, but it had no pictures
              or conversations in it.</mark>
            </p>
            <p class="annotation-demo__text">
              So she was considering in her own mind whether the pleasure of
              making a daisy-chain would be worth the trouble of getting up and
              picking the daisies.
            </p>
          </div>

          <aside class="note-card" aria-label="Example note">
            <div class="note-card__head">Note · Chapter I</div>
            <blockquote>
              “...what is the use of a book, without pictures or conversations?”
            </blockquote>
            <p>
              Alice wants a book with pictures and conversation. The web edition
              keeps both.
            </p>
            <div class="note-card__foot">
              <span>Copy as Markdown</span>
              <span>Export JSON</span>
            </div>
          </aside>
        </div>
        <figcaption>
          An illustrative look at the browser-only annotation layer. Nothing is
          uploaded.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="private" id="privacy">
    <div class="container private__grid">
      <div class="private__lead">
        <p class="eyebrow eyebrow--night">Local by design</p>
        <h2>
          Your book stays on<br />
          <span>your computer.</span>
        </h2>
        <p class="private__lede">
          There is no account and no upload. The app reads the EPUB on your
          machine and builds the site there. Run it again and you get the same
          site.
        </p>
        <a
          class="btn btn--light"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} />
          Read the source on GitHub
        </a>
      </div>

      <ul class="private__points">
        <li>
          <Icon name="lock" size={19} />
          <div>
            <h3>Nothing leaves your computer</h3>
            <p>
              The EPUB, the finished site, the logs, and any error reports stay
              on your machine. Highlights and notes stay in your browser.
            </p>
          </div>
        </li>
        <li>
          <Icon name="repeat" size={19} />
          <div>
            <h3>The same book gives the same site</h3>
            <p>
              Run the converter twice and you get the same text and structure.
              Only the build timestamp in the sitemap changes.
            </p>
          </div>
        </li>
        <li>
          <Icon name="code" size={19} />
          <div>
            <h3>You can check the work</h3>
            <p>
              The converter, the reader theme, and the tests are GPLv3 licensed.
              If you want to know exactly what happens to your book, the code is
              there to read.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section process" id="how-it-works">
    <div class="container">
      <header class="section-intro section-intro--center">
        <p class="eyebrow">How it works</p>
        <h2>
          From EPUB to website<br />
          <span class="accent">in three steps.</span>
        </h2>
        <p class="lede">
          The desktop app includes the converter, Python, and the fonts. Choose
          a book, press Convert, and the finished site opens in your browser.
        </p>
      </header>

      <ol class="steps">
        <li class="step">
          <span class="step__num">01</span>
          <h3>Choose your EPUB</h3>
          <p>
            Pick a book you own. Standard EPUB 2 and EPUB 3 files work best.
          </p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3>Press Convert</h3>
          <p>
            The app converts the book and checks each page as it goes. Progress
            is visible, so a long book does not look stuck.
          </p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3>Read it or publish it</h3>
          <p>
            Read the site in your browser, or upload the folder to any static
            host.
          </p>
        </li>
      </ol>

      <p class="process__cli">
        <span>Prefer the command line?</span>
        <code>pipx install git+https://github.com/Gowwre/epub2web</code>
        <a class="text-link" href={README_URL} target="_blank" rel="noopener noreferrer">
          Read the docs
          <Icon name="arrow-up-right" size={13} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq__layout">
      <aside class="faq__aside">
        <p class="eyebrow">Questions</p>
        <h2>Before you download.</h2>
        <p class="faq__intro">
          What people ask before trying epub2web, including where the files go
          and why your computer may warn you the first time you open the app.
        </p>
        <a
          class="text-link"
          href={ISSUES_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ask a question on GitHub
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </aside>

      <div class="faq__list">
        <details class="faq-item faq-item--first" id="first-launch">
          <summary>
            Why does my computer warn me when I open the app?
            <span class="faq-item__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq-item__answer">
            <p>
              The desktop builds are not code-signed yet, so Windows SmartScreen
              and macOS Gatekeeper may warn about an unidentified developer on
              first launch. That is expected. Only continue with a file from the{" "}
              <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
                official GitHub releases page
              </a>.
            </p>
            <p>
              The download page has the step-by-step steps for Windows and
              macOS, including the Open Anyway flow.{" "}
              <a href={withBase("/download/#first-launch")}>
                Read the first-launch guide
              </a>
              {" "}or the{" "}
              <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">
                full notes in the README
              </a>.
            </p>
          </div>
        </details>

        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.question}
                <span class="faq-item__marker" aria-hidden="true" />
              </summary>
              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner">
      <p class="eyebrow">Get started</p>
      <h2>
        Make a web edition<br />
        <span class="accent">of your book.</span>
      </h2>
      <p class="closing__intro">
        Choose an EPUB, press Convert, and the finished site opens in your
        browser. Keep it, or share the folder with anyone.
      </p>
      <div class="closing__actions">
        <a class="btn btn--primary btn--large" href={withBase("/download/")}>
          <Icon name="download" size={17} />
          Download epub2web
        </a>
        <a
          class="btn btn--quiet btn--large"
          href={DEMO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the live demo
          <Icon name="arrow-up-right" size={15} class="btn-arrow" />
        </a>
      </div>
      <p class="closing__meta">
        Free &amp; open source · GPLv3 licensed · No account required ·{" "}
        <a href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">
          Latest release on GitHub
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------
     Hero
     ------------------------------------------------------------------ */

  .hero {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
  }

  .launch-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0.65rem 0.28rem 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.73rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .launch-pill__new {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .launch-pill__arrow {
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .launch-pill:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
  }

  .launch-pill:hover .launch-pill__arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .hero h1 {
    max-width: 12ch;
    margin-top: 1.35rem;
    font-size: clamp(3.2rem, 2.2rem + 3.8vw, 5.1rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
  }

  .hero__intro {
    max-width: 46ch;
    margin: 1.45rem 0 1.75rem;
    font-size: clamp(1.02rem, 0.98rem + 0.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.05rem;
    margin: 1.65rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .hero__meta li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__meta li + li::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .hero__visual {
    min-width: 0;
  }

  /* ------------------------------------------------------------------
     Shared section
     ------------------------------------------------------------------ */

  .section {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    border-top: 1px solid var(--rule);
  }

  .section-intro {
    max-width: 820px;
  }

  .section-intro h2 {
    max-width: 16ch;
    margin-top: 0.1rem;
    font-size: clamp(2.4rem, 1.7rem + 3vw, 4.3rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .section-intro .lede {
    margin-top: 1.2rem;
  }

  .section-intro--center {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .section-intro--center .eyebrow {
    justify-content: center;
  }

  .section-intro--center h2 {
    max-width: 24ch;
    margin-inline: auto;
  }

  .section-intro--center .lede {
    margin-inline: auto;
  }

  /* ------------------------------------------------------------------
     Fidelity
     ------------------------------------------------------------------ */

  .fidelity__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .fidelity__copy h2 {
    max-width: 18ch;
    margin-top: 0.1rem;
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .fidelity__copy .lede {
    max-width: 46ch;
    margin-top: 1.2rem;
  }

  .fidelity__checks {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .fidelity__checks li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .fidelity__check-label {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.12rem;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .fidelity__check-label .icon {
    color: var(--pass);
  }

  .fidelity__checks p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .fidelity__failnote {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .fidelity__failnote .icon {
    margin-top: 0.12rem;
    color: var(--pass);
  }

  .fidelity__failnote strong {
    color: var(--ink);
  }

  /* ------------------------------------------------------------------
     Colophon
     ------------------------------------------------------------------ */

  .colophon {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    margin: 0;
    padding: clamp(1.4rem, 2.8vw, 2rem);
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: var(--shadow-soft);
  }

  .colophon__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .colophon__kicker {
    margin: 0 0 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .colophon h3 {
    font-size: 1.35rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--pass) 35%, var(--rule));
    border-radius: 999px;
    background: var(--pass-soft);
    color: var(--pass);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .colophon__rows {
    margin: 0;
    padding: 0;
  }

  .colophon__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .colophon__row dt {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .colophon__dots {
    align-self: end;
    margin-bottom: 0.28em;
    border-bottom: 1px dotted var(--rule-strong);
  }

  .colophon__row dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    text-align: right;
  }

  .colophon figcaption {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .colophon figcaption::before {
    content: "";
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--pass);
  }

  /* ------------------------------------------------------------------
     The edition
     ------------------------------------------------------------------ */

  .edition {
    background: var(--paper-2);
    border-block: 1px solid var(--rule);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.2rem, 4vw, 3.5rem);
  }

  .feature {
    --card-pad: clamp(1.2rem, 2.4vw, 1.7rem);
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--card-pad);
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .feature--reading {
    grid-column: span 7;
  }

  .feature--search {
    grid-column: span 5;
  }

  .feature--file,
  .feature--book,
  .feature--a11y {
    grid-column: span 4;
  }

  .feature > .icon {
    margin-bottom: 0.9rem;
    color: var(--accent);
  }

  .feature h3 {
    margin-bottom: 0.35rem;
    font-size: clamp(1.25rem, 1.15rem + 0.3vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .feature p {
    max-width: 42ch;
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .feature__media {
    margin: 1.4rem calc(var(--card-pad) * -1) calc(var(--card-pad) * -1);
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .feature__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .feature--search .feature__media img {
    aspect-ratio: 4 / 3;
  }

  .feature__media-caption {
    padding: 0.55rem var(--card-pad) 0.65rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.65rem;
    color: var(--muted);
  }

  .file-tree {
    margin: 1rem 0 0;
    padding: 0.8rem 0.9rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    font-size: 0.67rem;
    line-height: 1.9;
    color: var(--ink-2);
  }

  .tree-root {
    color: var(--accent);
    font-weight: 650;
  }

  .tree-file {
    color: var(--ink);
  }

  .tree-dir {
    color: var(--ink);
    font-weight: 650;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: auto 0 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.64rem;
    color: var(--ink-2);
  }

  .edition__link {
    margin: 1.8rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    text-align: right;
  }

  /* ------------------------------------------------------------------
     Highlights and notes
     ------------------------------------------------------------------ */

  .annotations__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .annotations__copy h2 {
    max-width: 10ch;
    margin-top: 0.1rem;
    font-size: clamp(2.5rem, 1.8rem + 3.2vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .annotations__copy .lede {
    max-width: 44ch;
    margin-top: 1.2rem;
  }

  .annotation-points {
    margin: 1.8rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .annotation-points li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.7rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .annotation-points > li > .icon {
    margin-top: 0.15rem;
    color: var(--accent);
  }

  .annotation-points h3 {
    margin-bottom: 0.2rem;
    font-size: 1.08rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .annotation-points p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.58;
    color: var(--ink-2);
  }

  .annotations__more {
    margin: 1.3rem 0 0;
  }

  .annotation-demo {
    margin: 0;
  }

  .annotation-demo__stage {
    position: relative;
  }

  .annotation-demo__page {
    position: relative;
    z-index: 1;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: var(--shadow-soft);
  }

  .annotation-demo__kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .annotation-demo__page h3 {
    margin-bottom: 1rem;
    font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .annotation-demo__text {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.92rem + 0.22vw, 1.08rem);
    line-height: 1.72;
    color: var(--ink-2);
  }

  .annotation-demo__text + .annotation-demo__text {
    margin-top: 0.9rem;
  }

  .annotation-demo mark {
    padding: 0 0.08em;
    border-radius: 2px;
    background: var(--highlight);
    color: var(--highlight-ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .note-card {
    position: relative;
    z-index: 2;
    width: min(340px, 88%);
    margin: -1.1rem 0.8rem 0 auto;
    padding: 1rem 1.1rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--highlight);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-deep);
  }

  .note-card__head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .note-card__head::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--highlight);
  }

  .note-card blockquote {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.03rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .note-card p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .note-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    color: var(--muted);
  }

  .note-card__foot span {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  .annotation-demo figcaption {
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ------------------------------------------------------------------
     Local by design
     ------------------------------------------------------------------ */

  .private {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--night);
    color: var(--night-ink);
  }

  .private__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .private h2 {
    max-width: 11ch;
    margin-top: 0.1rem;
    font-size: clamp(2.7rem, 1.9rem + 3.6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .private h2 span {
    color: var(--night-accent);
  }

  .private__lede {
    max-width: 46ch;
    margin: 1.4rem 0 1.8rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--night-muted);
  }

  .btn--light {
    border-color: var(--night-rule);
    background: transparent;
    color: var(--night-ink);
  }

  .btn--light:hover {
    border-color: var(--night-accent);
    color: var(--night-accent);
  }

  .private__points {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--night-rule);
    list-style: none;
  }

  .private__points li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--night-rule);
  }

  .private__points .icon {
    margin-top: 0.1rem;
    color: var(--night-accent);
  }

  .private__points h3 {
    margin-bottom: 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .private__points p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--night-muted);
  }

  /* ------------------------------------------------------------------
     Process
     ------------------------------------------------------------------ */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-strong);
  }

  .step__num {
    display: block;
    margin-bottom: 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .step h3 {
    margin-bottom: 0.35rem;
    font-size: clamp(1.35rem, 1.2rem + 0.4vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .step p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .process__cli {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.8rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
  }

  .process__cli code {
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    font-size: 0.72rem;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .process__cli a {
    font-weight: 600;
  }

  /* ------------------------------------------------------------------
     FAQ
     ------------------------------------------------------------------ */

  .faq {
    background: var(--paper-2);
  }

  .faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .faq__aside {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .faq__aside h2 {
    max-width: 8ch;
    font-size: clamp(2.3rem, 1.7rem + 2.5vw, 3.7rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .faq__intro {
    max-width: 34ch;
    margin: 1.1rem 0 1.4rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .faq__list {
    border-top: 1px solid var(--rule-strong);
  }

  .faq-item {
    border-bottom: 1px solid var(--rule);
  }

  .faq-item--first {
    border-top: 2px solid color-mix(in srgb, var(--accent) 50%, var(--rule-strong));
    margin-top: -1px;
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.2rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.24rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__marker {
    position: relative;
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: 0.22rem;
  }

  .faq-item__marker::before,
  .faq-item__marker::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 1px;
    background: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .faq-item__marker::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-item__marker::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-item summary:hover {
    color: var(--accent);
  }

  .faq-item__answer {
    max-width: 70ch;
    padding-bottom: 1.3rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }

  .faq-item__answer a {
    color: var(--accent);
  }

  /* ------------------------------------------------------------------
     Closing
     ------------------------------------------------------------------ */

  .closing {
    padding-block: clamp(5rem, 9vw, 8.5rem);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .closing__inner {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .closing .eyebrow {
    justify-content: center;
  }

  .closing h2 {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2.8rem, 1.9rem + 4.2vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .closing__intro {
    max-width: 52ch;
    margin: 1.3rem auto 1.7rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .closing__meta {
    margin: 2rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .closing__meta a {
    color: var(--muted);
    text-decoration-color: var(--rule-strong);
  }

  .closing__meta a:hover {
    color: var(--accent);
  }

  /* ------------------------------------------------------------------
     Responsive
     ------------------------------------------------------------------ */

  @media (max-width: 1120px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.96fr);
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 1.9rem + 4.2vw, 4.7rem);
    }
  }

  @media (max-width: 1020px) {
    .fidelity__grid,
    .annotations__grid,
    .private__grid,
    .faq__layout {
      grid-template-columns: 1fr;
    }

    .fidelity__copy,
    .annotations__copy,
    .private__lead,
    .faq__aside {
      max-width: 680px;
    }

    .colophon {
      position: static;
    }

    .annotation-demo {
      max-width: 680px;
      width: 100%;
      margin-inline: auto;
    }

    .faq__aside {
      position: static;
    }

    .private__points {
      max-width: 680px;
    }
  }

  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 7vw, 4rem);
    }

    .hero__copy {
      max-width: 680px;
    }

