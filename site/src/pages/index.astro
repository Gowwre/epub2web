---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  LATEST_RELEASE_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../consts";

const home720 = withBase("/screenshots/home-720.webp");
const home1440 = withBase("/screenshots/home-1440.webp");
const reading720 = withBase("/screenshots/reading-720.webp");
const reading1440 = withBase("/screenshots/reading-1440.webp");
const searchCrop = withBase("/screenshots/search-crop.webp");

const gates = [
  {
    number: "01",
    title: "Text, word for word.",
    body: "Every rendered page is compared with its EPUB source — tokens and characters. A dropped clause, changed punctuation mark, or moved paragraph stops the build.",
  },
  {
    number: "02",
    title: "Images, accounted for.",
    body: "The image count on every page is checked against its source. A missing figure fails the build instead of leaving a hole in a published book.",
  },
  {
    number: "03",
    title: "Links, followed through.",
    body: "Every internal link, anchor, asset, and duplicate ID is verified before anything is published. No quiet 404s between chapters.",
  },
];

const features = [
  {
    number: "01",
    title: "Cover & contents",
    body: "A proper cover page and a clickable table of contents, not a flat scroll of everything.",
  },
  {
    number: "02",
    title: "Search, built in",
    body: "A static full-text index ships with the site and loads when needed. No search server, no account.",
  },
  {
    number: "03",
    title: "Light & dark",
    body: "A paper-and-ink reading theme in both modes, with the reader's choice remembered.",
  },
  {
    number: "04",
    title: "The whole book",
    body: "Figures, captions, tables, lists, notes, and cross-references all survive the move.",
  },
  {
    number: "05",
    title: "Accessible by default",
    body: "Keyboard navigation, clear labels, and descriptions for images are part of the edition.",
  },
  {
    number: "06",
    title: "Yours to host",
    body: "One folder of HTML, CSS, images, fonts, and search data. Put it anywhere, or keep it local.",
  },
];

const faqs = [
  {
    question: "Is my book uploaded anywhere?",
    answer:
      "No. The EPUB is read on your computer, the site is built on your computer, and the finished folder stays there. There is no account and no upload step. Publishing it later is entirely your choice.",
  },
  {
    question: "Does epub2web use AI?",
    answer:
      "No. It does not call a language model, summarize prose, or fetch anything from a remote service during a build. The text you see is the text in your EPUB, and the same book produces the same result every time.",
  },
  {
    question: "What exactly do I get?",
    answer:
      "A static website folder: a cover, contents, every chapter as a reading page, optimized images, self-hosted fonts, a search index, a sitemap, and a small accessibility-minded theme. No Node build step, database, or server-side runtime.",
  },
  {
    question: "How do I open the site after I close the app?",
    answer:
      "The preview stops when the app closes. Reopen the app, choose the same EPUB, and click Convert to refresh and preview the existing site. You can also serve the site folder with any local static server. See “Run the site” above for commands.",
  },
  {
    question: "Which EPUBs work best?",
    answer:
      "Normal, reflowable EPUB 2 and EPUB 3 books work best. DRM-protected, fixed-layout, and image-only books may not work. Books that load images from the internet are refused so the finished site remains self-contained.",
  },
  {
    question: "What if my book does not convert?",
    answer:
      "epub2web stops rather than dropping content, leaves any previous working site untouched, and writes a support ZIP. Attach that ZIP to a GitHub issue, but not the book itself. The ZIP can contain file paths, metadata, and short excerpts, so review it first.",
  },
  {
    question: "Can I put the site online?",
    answer:
      "Yes. The output is a plain static folder, so it works on GitHub Pages, Cloudflare Pages, Netlify, S3, nginx, or any other static host. Subpath hosting is supported with the command-line --base-path option.",
  },
  {
    question: "Can I use the command line instead?",
    answer:
      "Yes. epub2web is a Python package for Python 3.10 and newer, and the CLI exposes preview, output, metadata, logging, and verification options. The desktop app is a friendly front end to the same pipeline.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">EPUB → a reading website</p>
        <h1 class="hero__title">
          <span>Your book,</span>
          <span class="hero__title-accent">opened to the web.</span>
        </h1>
        <p class="hero__intro">
          A clean, static reading site made from the EPUB you already own. Every
          word, figure, note, and link checked. Nothing uploaded. Nothing
          rewritten.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary btn--large" href={withBase("/download/")}>
            <Icon name="download" size={17} />
            Download the app
          </a>
          <a
            class="btn btn--quiet btn--large"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Try the live demo
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </div>

        <ul class="hero__meta" aria-label="At a glance">
          <li>Free &amp; open source</li>
          <li>Windows · macOS · Linux</li>
          <li>No Python required</li>
        </ul>

        <p class="hero__audience">
          For authors, translators, publishers, teachers, and readers.
        </p>
      </div>

      <div class="hero__visual">
        <figure class="browser-frame hero__edition">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><span></span><span></span><span></span></span>
            <span class="browser-url">
              <Icon name="lock" size={10} />
              gowwre.github.io/epub2web/demo
            </span>
            <span class="browser-menu">···</span>
          </div>
          <img
            src={home1440}
            srcset={`${home720} 720w, ${home1440} 1440w`}
            sizes="(max-width: 980px) 100vw, 46vw"
            width="1440"
            height="1000"
            alt="The epub2web reader home page for Alice's Adventures in Wonderland, showing a cover, title, author, and Start reading button."
            fetchpriority="high"
          />
        </figure>

        <aside class="verify-card" aria-label="Example build verification">
          <span class="verify-card__seal" aria-hidden="true">PASS</span>
          <p class="verify-card__eyebrow">Build verified</p>
          <ul>
            <li><Icon name="check" size={13} /> 13/13 pages exact</li>
            <li><Icon name="check" size={13} /> 743 links checked</li>
            <li><Icon name="check" size={13} /> 0 bytes uploaded</li>
          </ul>
        </aside>

        <p class="hero__caption">
          A real edition of <cite>Alice's Adventures in Wonderland</cite>.
          Built in 0.57 seconds.
        </p>
      </div>
    </div>
  </section>

  <div class="promise-bar">
    <div class="container">
      <ul>
        <li><Icon name="check" size={13} /> Every page checked</li>
        <li><Icon name="check" size={13} /> Nothing uploaded</li>
        <li><Icon name="check" size={13} /> No AI, ever</li>
        <li><Icon name="check" size={13} /> One static folder</li>
      </ul>
    </div>
  </div>

  <section class="section fidelity" id="fidelity">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">I · The rule</p>
          <h2>
            The EPUB is the{" "}
            <span class="accent">source of truth.</span>
          </h2>
        </div>
        <div class="section-heading__side">
          <p class="fidelity__quote">“The design changes. The book does not.”</p>
          <p class="fidelity__intro">
            epub2web can change structure and presentation. It cannot lose your
            words. Three gates stand between your EPUB and a published site.
          </p>
        </div>
      </div>

      <div class="gate-grid">
        {
          gates.map((gate) => (
            <article class="gate">
              <span class="gate__num">{gate.number}</span>
              <h3>{gate.title}</h3>
              <p>{gate.body}</p>
            </article>
          ))
        }
      </div>

      <div class="proof">
        <figure class="build-report">
          <div class="build-report__bar" aria-hidden="true">
            <span class="build-report__dots"><span></span><span></span><span></span></span>
            <span class="build-report__title">one real run</span>
          </div>
          <pre><code><span class="report-muted">$</span> epub2web alice.epub --serve
<span class="report-label">EPUB</span>     Alice's Adventures in Wonderland
<span class="report-label">Pages</span>    13
<span class="report-label">Words</span>    29,564
<span class="report-label">Verify</span>   <span class="report-pass">PASS (13/13 pages exact)</span>
<span class="report-label">Links</span>    <span class="report-pass">PASS (743 checked, 0 broken)</span>
<span class="report-label">Search</span>   16 sections indexed
<span class="report-label">Site</span>     <span class="report-accent">alice-site/index.html</span>
<span class="report-label">Time</span>     0.57s</code></pre>
        </figure>

        <div class="proof__copy">
          <p class="eyebrow">Nothing half-published</p>
          <h3>A failed build is not a published book.</h3>
          <p>
            The site is assembled in a staging folder, verified, and only then
            swapped into place. If extraction or any gate fails, your previous
            working site stays exactly as it was.
          </p>
          <ul class="check-list">
            <li><Icon name="check" size={14} /> Staged, checked, then published.</li>
            <li><Icon name="check" size={14} /> Images and links included in the gate.</li>
            <li><Icon name="check" size={14} /> No model or remote service in the loop.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section edition" id="edition">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">II · The edition</p>
          <h2>Not a <span class="accent">document dump.</span></h2>
        </div>
        <p class="lede">
          A complete reading edition: cover, contents, chapters, figures, notes,
          and search. All of it a plain folder you can keep or publish.
        </p>
      </div>

      <div class="result-visual">
        <figure class="browser-frame reading-shot">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><span></span><span></span><span></span></span>
            <span class="browser-url">alice-site / read / 1</span>
            <span class="browser-menu">···</span>
          </div>
          <img
            src={reading1440}
            srcset={`${reading720} 720w, ${reading1440} 1440w`}
            sizes="(max-width: 900px) 100vw, 66vw"
            width="1440"
            height="1000"
            alt="The reading view: a chapter of Alice's Adventures in Wonderland with a contents sidebar, progress line, and comfortable serif typography."
            loading="lazy"
          />
        </figure>

        <figure class="search-shot">
          <div class="search-shot__bar">
            <span><Icon name="search" size={14} /> Search the book</span>
            <kbd>/</kbd>
          </div>
          <img
            src={searchCrop}
            width="660"
            height="890"
            alt="The built-in search panel showing highlighted results for the word rabbit across chapters."
            loading="lazy"
          />
          <figcaption class="figure-caption">
            Full-text results, generated with the site. No search server.
          </figcaption>
        </figure>
      </div>

      <div class="feature-ledger">
        {
          features.map((feature) => (
            <article class="feature-row">
              <span class="feature-row__num">{feature.number}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="edition__more">
        <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Open the live edition
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="private" id="privacy">
    <div class="container private__grid">
      <div class="private__lead">
        <p class="eyebrow eyebrow--night">III · The promise</p>
        <h2>
          Nothing is uploaded.<br />
          Nothing is rewritten.<br />
          <span>Nothing is guessed.</span>
        </h2>
        <p class="private__lede">
          No account. No AI service. No network at build time. The same EPUB
          produces the same text and structure, run after run.
        </p>
        <a
          class="btn btn--light"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} />
          Read the source on GitHub
        </a>
      </div>

      <div class="private__points">
        <article class="private-point">
          <span>01</span>
          <div>
            <h3>Stays on your computer</h3>
            <p>
              Your EPUB, the generated site, logs, and failure reports remain on
              your machine. Nothing is sent to a server.
            </p>
          </div>
        </article>
        <article class="private-point">
          <span>02</span>
          <div>
            <h3>Deterministic by design</h3>
            <p>
              No model, no remote fetch, no clever guess. Only the sitemap's
              build timestamp changes between runs.
            </p>
          </div>
        </article>
        <article class="private-point">
          <span>03</span>
          <div>
            <h3>Open all the way down</h3>
            <p>
              The converter, reader theme, and tests are MIT licensed. You can
              audit exactly what happens to your book.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section process" id="how-it-works">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">IV · The process</p>
          <h2>Three steps. <span class="accent">One static folder.</span></h2>
        </div>
        <p class="lede">
          The desktop app bundles everything it needs. Choose a book, press
          Convert, and the finished site opens in your browser.
        </p>
      </div>

      <ol class="steps">
        <li class="step">
          <span class="step__num">01</span>
          <h3>Choose your EPUB</h3>
          <p>
            A book you own, in the standard reflowable EPUB 2 or EPUB 3 format.
            No conversion prep, no account.
          </p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3>Press Convert</h3>
          <p>
            Pages, images, and links are converted and checked with live,
            page-by-page progress. A long book does not look frozen.
          </p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3>Read, or publish</h3>
          <p>
            Read through the app&apos;s preview, or upload the plain folder to
            any static host. The site works without a server-side runtime.
          </p>
        </li>
      </ol>

      <div class="process__output">
        <figure class="output-card">
          <div class="output-card__head">
            <span>What lands on disk</span>
            <span class="output-card__badge">static</span>
          </div>
          <pre><code><span class="tree-root">book-site/</span>
├── <span class="tree-file">index.html</span>
├── <span class="tree-file">contents/index.html</span>
├── <span class="tree-file">read/1/index.html</span>
├── <span class="tree-file">read/2/index.html</span>
├── <span class="tree-dir">assets/</span>        <span class="tree-note">CSS, JS, self-hosted fonts</span>
├── <span class="tree-dir">images/</span>        <span class="tree-note">optimized figures</span>
├── <span class="tree-file">search-index.json</span>
├── <span class="tree-file">sitemap.xml</span>
└── <span class="tree-file">robots.txt</span></code></pre>
        </figure>

        <div class="process__copy">
          <h3>No Node build step. No database. No server required.</h3>
          <p>
            A finished book is just files. Keep it on your computer, put it on a
            USB stick, or serve it from anywhere that can deliver static HTML.
            Re-running the app refreshes an existing epub2web site automatically.
          </p>
          <p>
            On the desktop, sites land in{" "}
            <code>Documents/epub2web/&lt;book&gt;-site</code>. Closing the app
            does not remove the site or your books.
          </p>

          <details class="cli-details">
            <summary>Prefer the command line?</summary>
            <p>
              epub2web is also a Python package for Python 3.10 and newer. Install
              it from GitHub with <code>pipx</code>, then build and preview:
            </p>
            <pre class="cli-code"><code>pipx install git+https://github.com/Gowwre/epub2web
epub2web book.epub --serve</code></pre>
            <p class="cli-details__foot">
              Full options are in the{" "}
              <a href={README_URL} target="_blank" rel="noopener noreferrer">README</a>.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="section run-site" id="run-site">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">V · Run it</p>
          <h2>Serve the folder. <span class="accent">Don&apos;t double-click.</span></h2>
        </div>
        <div class="section-heading__side">
          <p class="lede">
            The finished edition uses absolute links and loads its search index
            over HTTP. The app previews it while open; later, use any local
            static server or publish the folder.
          </p>
          <p class="run-site__docs">
            <a
              class="text-link"
              href={`${README_URL}#run-the-site`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Full run and hosting guide
              <Icon name="arrow-up-right" size={14} class="icon--external" />
            </a>
          </p>
        </div>
      </div>

      <div class="run-site__grid">
        <div class="run-site__steps">
          <article class="run-step">
            <span class="run-step__num">01</span>
            <div>
              <h3>Keep the app open</h3>
              <p>
                The desktop app starts a local server and opens your book.{" "}
                <strong>Stop</strong> shuts it down; closing the window does too.
              </p>
            </div>
          </article>
          <article class="run-step">
            <span class="run-step__num">02</span>
            <div>
              <h3>Or open it again</h3>
              <p>
                Reopen the app, choose the same EPUB, and press{" "}
                <strong>Convert</strong>. It refreshes the existing site and
                starts the preview again.
              </p>
            </div>
          </article>
          <article class="run-step">
            <span class="run-step__num">03</span>
            <div>
              <h3>Or serve it yourself</h3>
              <p>
                Start any static file server from the site folder. Python is one
                option; the commands are on the right.
              </p>
            </div>
          </article>
        </div>

        <figure class="run-code">
          <div class="run-code__head">
            <span>Terminal</span>
            <span>local preview</span>
          </div>
          <div class="run-code__block">
            <span>macOS / Linux</span>
            <pre><code>cd ~/Documents/epub2web/my-book-site
python3 -m http.server 8000</code></pre>
          </div>
          <div class="run-code__block">
            <span>Windows PowerShell</span>
            <pre><code>cd ~\Documents\epub2web\my-book-site
py -m http.server 8000</code></pre>
          </div>
          <figcaption>
            Replace <code>my-book-site</code> with your folder name, then open{" "}
            <code>http://localhost:8000/</code>. Any static file server works.
          </figcaption>
        </figure>
      </div>

      <p class="run-site__note">
        <Icon name="alert" size={15} />
        <span>
          Opening <code>index.html</code> from your filesystem is not enough:
          absolute links and the search index need <code>http://</code>.
        </span>
      </p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq__layout">
      <aside class="faq__aside">
        <p class="eyebrow">VI · Questions</p>
        <h2>Before you download.</h2>
        <p class="faq__intro">
          Straight answers, including the warning your computer will probably
          show the first time you open the app.
        </p>
        <div class="faq__warning-note">
          <Icon name="alert" size={17} />
          <p>
            <strong>Unsigned, not unsafe.</strong> The desktop builds do not have
            paid code-signing certificates yet. Only continue with a file from
            the official releases page.
          </p>
        </div>
      </aside>

      <div class="faq__list">
        <details class="faq-item faq-item--warning" id="first-launch" open>
          <summary>
            Why does Windows or macOS warn me when I open the app?
            <span class="faq-item__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq-item__answer">
            <p>
              Windows SmartScreen and macOS Gatekeeper may warn about an
              unidentified developer on first launch. This is expected: the
              desktop builds are not code-signed yet. It does not mean the
              download was tampered with — but only continue if you downloaded it
              from the{" "}
              <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
                official GitHub releases page
              </a>.
            </p>

            <div class="warning-grid">
              <div class="warning-card">
                <h3><Icon name="windows" size={16} /> Windows</h3>
                <p>If “Windows protected your PC” appears:</p>
                <ol>
                  <li>Click <strong>More info</strong>.</li>
                  <li>Click <strong>Run anyway</strong>.</li>
                  <li>Open the app and choose your EPUB.</li>
                </ol>
                <p class="warning-card__note">
                  On a workplace or school PC, Smart App Control may block
                  unsigned apps entirely. Ask your administrator rather than
                  disabling security features.
                </p>
              </div>

              <div class="warning-card">
                <h3><Icon name="apple" size={16} /> macOS 15 and later</h3>
                <p>After dragging the app to Applications:</p>
                <ol>
                  <li>Try to open it once, then click <strong>Done</strong>.</li>
                  <li>
                    Open <strong>System Settings → Privacy &amp; Security</strong>.
                  </li>
                  <li>
                    Under <strong>Security</strong>, click{" "}
                    <strong>Open Anyway</strong>, then authenticate.
                  </li>
                  <li>Open the app again.</li>
                </ol>
                <p class="warning-card__note">
                  The Open Anyway button is available for about an hour after
                  the first attempt. On macOS 14 and earlier, right-click the
                  app and choose <strong>Open</strong>.
                </p>
              </div>
            </div>

            <p class="faq-item__fine">
              If macOS says the app is damaged, delete it, re-download from the
              official release, and try again. You can verify downloads against
              the SHA-256 checksums on the release page.{" "}
              <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">
                Full first-launch guide
              </a>.
            </p>
          </div>
        </details>

        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.question}
                <span class="faq-item__marker" aria-hidden="true" />
              </summary>
              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner">
      <span class="closing__watermark" aria-hidden="true">
        <Icon name="book" size={420} strokeWidth={0.8} />
      </span>
      <p class="eyebrow">VII · Your move</p>
      <h2>
        Give your book a<br />
        <span class="accent">home on the web.</span>
      </h2>
      <p class="closing__intro">
        Download the desktop app, choose an EPUB, and read the finished site in
        your browser. Then share it with anyone who has a browser.
      </p>
      <div class="closing__actions">
        <a class="btn btn--primary btn--large" href={withBase("/download/")}>
          <Icon name="download" size={17} />
          Download epub2web
