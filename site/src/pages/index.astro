---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  LATEST_RELEASE_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../consts";

const home720 = withBase("/screenshots/home-720.webp");
const home1440 = withBase("/screenshots/home-1440.webp");
const reading720 = withBase("/screenshots/reading-720.webp");
const reading1440 = withBase("/screenshots/reading-1440.webp");
const searchCrop = withBase("/screenshots/search-crop.webp");

const gates = [
  {
    number: "01",
    title: "The words come through unchanged.",
    body: "Each page is compared with the EPUB it came from. If a sentence is dropped, punctuation changes, or a paragraph moves, the build stops.",
  },
  {
    number: "02",
    title: "Every picture has to be there.",
    body: "The image count on each page is checked against the source. If a figure is missing, the build fails instead of publishing a book with a hole in it.",
  },
  {
    number: "03",
    title: "Links work before the site goes live.",
    body: "Internal links, anchors, images, and duplicate IDs are checked before anything is published. Readers don't hit a dead end between chapters.",
  },
];

const features = [
  {
    number: "01",
    title: "Cover and contents",
    body: "A cover page and a table of contents you can click through, instead of one long scroll.",
  },
  {
    number: "02",
    title: "Search the whole book",
    body: "The whole book is indexed when the site is built. Search for a word and jump straight to it; no search service or account.",
  },
  {
    number: "03",
    title: "Easy on the eyes",
    body: "Light and dark themes, adjustable text size, line spacing, paragraph style, and page width. Your choices are remembered the next time you open the book.",
  },
  {
    number: "04",
    title: "Pick up where you left off",
    body: "The site remembers your page and shows how far you've read. Your place is stored in the browser, separately for each EPUB.",
  },
  {
    number: "05",
    title: "The whole book comes along",
    body: "Pictures with captions, tables, lists, footnotes, and cross-references all survive the move. Fonts for major writing systems are included, so the text looks right.",
  },
  {
    number: "06",
    title: "Works for more readers",
    body: "You can navigate with a keyboard, labels are clear, and images have descriptions.",
  },
  {
    number: "07",
    title: "Yours to keep",
    body: "The finished site is one folder of HTML, CSS, images, fonts, and search data. Put it on any static host, or keep it on your computer.",
  },
];

const faqs = [
  {
    question: "Is my book uploaded anywhere?",
    answer:
      "No. The EPUB is read on your computer, the site is built there, and the finished folder stays there. There is no account and no upload step. If you want to publish it later, that's up to you.",
  },
  {
    question: "Will the text be changed?",
    answer:
      "No. The words and punctuation stay as they are. The site may change how the book looks, but not what it says.",
  },
  {
    question: "What exactly do I get?",
    answer:
      "A folder with a cover page, a table of contents, a page for each chapter, the images, the fonts, and a search index. It includes a small reading theme that works on phones and desktops.",
  },
  {
    question: "How do I open the site after I close the app?",
    answer:
      "The preview stops when the app closes. Reopen the app, choose the same EPUB, and press Convert to refresh the site and start the preview again. You can also serve the folder with any local static server; the commands are above.",
  },
  {
    question: "Which EPUBs work best?",
    answer:
      "Normal, reflowable EPUB 2 and EPUB 3 books work best. DRM-protected, fixed-layout, and image-only books may not work. Books that load images from the internet are refused, so the finished site doesn't depend on another server.",
  },
  {
    question: "What if my book doesn't convert?",
    answer:
      "epub2web stops instead of dropping content, leaves any previous working site untouched, and creates a support ZIP you can attach to a GitHub issue. Don't attach the book itself. The ZIP can contain file paths, metadata, and short excerpts, so look through it first.",
  },
  {
    question: "Can I put the site online?",
    answer:
      "Yes. The output is a plain static folder, so it works on GitHub Pages, Cloudflare Pages, Netlify, S3, nginx, or any other static host. Subpath hosting is supported with the command-line --base-path option.",
  },
  {
    question: "Can I use the command line instead?",
    answer:
      "Yes. epub2web is a Python package for Python 3.10 and newer. The CLI offers preview, output, metadata, logging, and verification options. The desktop app runs the same converter with a window around it.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">EPUB → a reading website</p>
        <h1 class="hero__title">
          <span>Turn an EPUB</span>
          <span class="hero__title-accent">into a website.</span>
        </h1>
        <p class="hero__intro">
          epub2web builds a reading website from the EPUB you own. The text
          stays exactly as it appears in the EPUB, the pictures and notes come
          along, and the finished folder is yours to keep or publish.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary btn--large" href={withBase("/download/")}>
            <Icon name="download" size={17} />
            Download the app
          </a>
          <a
            class="btn btn--quiet btn--large"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Try the live demo
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </div>

        <ul class="hero__meta" aria-label="At a glance">
          <li>Free &amp; open source</li>
          <li>Windows · macOS · Linux</li>
          <li>No Python required</li>
        </ul>

        <p class="hero__audience">
          For authors, translators, small presses, and anyone else with a book
          to share.
        </p>
      </div>

      <div class="hero__visual">
        <figure class="browser-frame hero__edition">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><span></span><span></span><span></span></span>
            <span class="browser-url">
              <Icon name="lock" size={10} />
              gowwre.github.io/epub2web/demo
            </span>
            <span class="browser-menu">···</span>
          </div>
          <img
            src={home1440}
            srcset={`${home720} 720w, ${home1440} 1440w`}
            sizes="(max-width: 980px) 100vw, 46vw"
            width="1440"
            height="1000"
            alt="The epub2web reader home page for Alice's Adventures in Wonderland, showing a cover, title, author, and Start reading button."
            fetchpriority="high"
          />
        </figure>

        <aside class="verify-card" aria-label="Example build verification">
          <span class="verify-card__seal" aria-hidden="true">PASS</span>
          <p class="verify-card__eyebrow">Build verified</p>
          <ul>
            <li><Icon name="check" size={13} /> 13/13 pages match</li>
            <li><Icon name="check" size={13} /> 743 links checked</li>
            <li><Icon name="check" size={13} /> Nothing uploaded</li>
          </ul>
        </aside>

        <p class="hero__caption">
          Converted in 0.57 seconds.
        </p>
      </div>
    </div>
  </section>

  <div class="promise-bar">
    <div class="container">
      <ul>
        <li><Icon name="check" size={13} /> Every page checked</li>
        <li><Icon name="check" size={13} /> Your text unchanged</li>
        <li><Icon name="check" size={13} /> Nothing uploaded</li>
        <li><Icon name="check" size={13} /> One folder to share</li>
      </ul>
    </div>
  </div>

  <section class="section fidelity" id="fidelity">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">I · The rule</p>
          <h2>
            What's in the EPUB is{" "}
            <span class="accent">what goes online.</span>
          </h2>
        </div>
        <div class="section-heading__side">
          <p class="fidelity__quote">“The layout can change. The words can't.”</p>
          <p class="fidelity__intro">
            epub2web changes how a book looks on the web. It doesn't change what
            the book says. Three checks stand between your EPUB and a finished
            site.
          </p>
        </div>
      </div>

      <div class="gate-grid">
        {
          gates.map((gate) => (
            <article class="gate">
              <span class="gate__num">{gate.number}</span>
              <h3>{gate.title}</h3>
              <p>{gate.body}</p>
            </article>
          ))
        }
      </div>

      <div class="proof">
        <figure class="build-report">
          <div class="build-report__bar" aria-hidden="true">
            <span class="build-report__dots"><span></span><span></span><span></span></span>
            <span class="build-report__title">a real build</span>
          </div>
          <pre><code><span class="report-muted">$</span> epub2web alice.epub --serve
<span class="report-label">EPUB</span>     Alice's Adventures in Wonderland
<span class="report-label">Pages</span>    13
<span class="report-label">Words</span>    29,564
<span class="report-label">Verify</span>   <span class="report-pass">PASS (13/13 pages match)</span>
<span class="report-label">Links</span>    <span class="report-pass">PASS (743 checked, 0 broken)</span>
<span class="report-label">Search</span>   16 sections indexed
<span class="report-label">Site</span>     <span class="report-accent">alice-site/index.html</span>
<span class="report-label">Time</span>     0.57s</code></pre>
        </figure>

        <div class="proof__copy">
          <p class="eyebrow">If something goes wrong</p>
          <h3>You keep the last good version.</h3>
          <p>
            The new site is built in a staging folder and checked before it
            replaces anything. If a check fails, your previous site stays
            exactly where it was.
          </p>
          <ul class="check-list">
            <li><Icon name="check" size={14} /> Built in a staging folder first.</li>
            <li><Icon name="check" size={14} /> Text, images, and links are all checked.</li>
            <li><Icon name="check" size={14} /> A failed build changes nothing.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section edition" id="edition">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">II · The edition</p>
          <h2>A website that <span class="accent">reads like a book.</span></h2>
        </div>
        <p class="lede">
          You get a cover, a table of contents, a page for each chapter, the
          pictures and notes, and search. It's all one folder you can keep or
          publish.
        </p>
      </div>

      <div class="result-visual">
        <figure class="browser-frame reading-shot">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><span></span><span></span><span></span></span>
            <span class="browser-url">alice-site / read / 1</span>
            <span class="browser-menu">···</span>
          </div>
          <img
            src={reading1440}
            srcset={`${reading720} 720w, ${reading1440} 1440w`}
            sizes="(max-width: 900px) 100vw, 66vw"
            width="1440"
            height="1000"
            alt="The reading view: a chapter of Alice's Adventures in Wonderland with a contents sidebar, progress line, and comfortable serif typography."
            loading="lazy"
          />
        </figure>

        <figure class="search-shot">
          <div class="search-shot__bar">
            <span><Icon name="search" size={14} /> Search the book</span>
            <kbd>/</kbd>
          </div>
          <img
            src={searchCrop}
            width="660"
            height="890"
            alt="The built-in search panel showing highlighted results for the word rabbit across chapters."
            loading="lazy"
          />
          <figcaption class="figure-caption">
            Search results come from the site itself.
          </figcaption>
        </figure>
      </div>

      <div class="feature-ledger">
        {
          features.map((feature) => (
            <article class="feature-row">
              <span class="feature-row__num">{feature.number}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="edition__more">
        <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Open the live demo
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="private" id="privacy">
    <div class="container private__grid">
      <div class="private__lead">
        <p class="eyebrow eyebrow--night">III · Your book stays yours</p>
        <h2>
          Your book stays<br />
          on your computer.<br />
          <span>The text stays intact.</span>
        </h2>
        <p class="private__lede">
          There's no account and no upload. The app reads the EPUB on your
          machine and builds the site there. Run it again and you get the same
          site.
        </p>
        <a
          class="btn btn--light"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} />
          Read the source on GitHub
        </a>
      </div>

      <div class="private__points">
        <article class="private-point">
          <span>01</span>
          <div>
            <h3>Nothing leaves your computer</h3>
            <p>
              The EPUB, the finished site, the logs, and any error reports stay
              on your machine. Nothing is sent to a server.
            </p>
          </div>
        </article>
        <article class="private-point">
          <span>02</span>
          <div>
            <h3>The same book gives the same site</h3>
            <p>
              Run the converter twice and you get the same text and structure.
              Only the build timestamp in the sitemap changes.
            </p>
          </div>
        </article>
        <article class="private-point">
          <span>03</span>
          <div>
            <h3>You can check the work</h3>
            <p>
              The converter, the reader theme, and the tests are MIT licensed.
              If you want to know exactly what happens to your book, the code is
              there to read.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section process" id="how-it-works">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">IV · How it works</p>
          <h2>From EPUB to website <span class="accent">in three steps.</span></h2>
        </div>
        <p class="lede">
          The desktop app comes with the converter, Python, and the fonts.
          Choose a book, press Convert, and the finished site opens in your
          browser.
        </p>
      </div>

      <ol class="steps">
        <li class="step">
          <span class="step__num">01</span>
          <h3>Choose your EPUB</h3>
          <p>
            Pick a book you own. Standard EPUB 2 and EPUB 3 files work best.
          </p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3>Press Convert</h3>
          <p>
            The app converts the book and checks each page as it goes. You can
            watch the progress, so a long book doesn't look stuck.
          </p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3>Read it or publish it</h3>
          <p>
            Read the site in your browser, or upload the folder to any static
            host.
          </p>
        </li>
      </ol>

      <div class="process__output">
        <figure class="output-card">
          <div class="output-card__head">
            <span>What lands on disk</span>
            <span class="output-card__badge">static</span>
          </div>
          <pre><code><span class="tree-root">book-site/</span>
├── <span class="tree-file">index.html</span>
├── <span class="tree-file">contents/index.html</span>
├── <span class="tree-file">read/1/index.html</span>
├── <span class="tree-file">read/2/index.html</span>
├── <span class="tree-dir">assets/</span>        <span class="tree-note">CSS, JS, self-hosted fonts</span>
├── <span class="tree-dir">images/</span>        <span class="tree-note">optimized figures</span>
├── <span class="tree-file">search-index.json</span>
├── <span class="tree-file">sitemap.xml</span>
└── <span class="tree-file">robots.txt</span></code></pre>
        </figure>

        <div class="process__copy">
          <h3>A finished site is just files.</h3>
          <p>
            Keep the folder on your computer, put it on a USB stick, or serve it
            from anywhere that can deliver static HTML. Running the app again
            refreshes an existing epub2web site automatically.
          </p>
          <p>
            On the desktop, sites land in{" "}
            <code>Documents/epub2web/&lt;book&gt;-site</code>. Closing the app
            does not remove the site or your books.
          </p>

          <details class="cli-details">
            <summary>Prefer the command line?</summary>
            <p>
              epub2web is also a Python package for Python 3.10 and newer. Install
              it from GitHub with <code>pipx</code>, then build and preview:
            </p>
            <pre class="cli-code"><code>pipx install git+https://github.com/Gowwre/epub2web
epub2web book.epub --serve</code></pre>
            <p class="cli-details__foot">
              Full options are in the{" "}
              <a href={README_URL} target="_blank" rel="noopener noreferrer">README</a>.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="section run-site" id="run-site">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">V · Reading it later</p>
          <h2>Serve the folder. <span class="accent">Don&apos;t double-click.</span></h2>
        </div>
        <div class="section-heading__side">
          <p class="lede">
            The finished site needs a web server, even on your own computer. The
            app starts one for you; later, you can use any local server or
            publish the folder.
          </p>
          <p class="run-site__docs">
            <a
              class="text-link"
              href={`${README_URL}#run-the-site`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Full run and hosting guide
              <Icon name="arrow-up-right" size={14} class="icon--external" />
            </a>
          </p>
        </div>
      </div>

      <div class="run-site__grid">
        <div class="run-site__steps">
          <article class="run-step">
            <span class="run-step__num">01</span>
            <div>
              <h3>Keep the app open</h3>
              <p>
                The desktop app starts a local server and opens your book.{" "}
                <strong>Stop</strong> shuts it down; closing the window does too.
              </p>
            </div>
          </article>
          <article class="run-step">
            <span class="run-step__num">02</span>
            <div>
              <h3>Or reopen the app</h3>
              <p>
                Choose the same EPUB and press <strong>Convert</strong>. It
                refreshes the site and starts the preview again.
              </p>
            </div>
          </article>
          <article class="run-step">
            <span class="run-step__num">03</span>
            <div>
              <h3>Or use your own server</h3>
              <p>
                Start any static file server from the site folder. Python is one
                option; the commands are on the right.
              </p>
            </div>
          </article>
        </div>

        <figure class="run-code">
          <div class="run-code__head">
            <span>Terminal</span>
            <span>local preview</span>
          </div>
          <div class="run-code__block">
            <span>macOS / Linux</span>
            <pre><code>cd ~/Documents/epub2web/my-book-site
python3 -m http.server 8000</code></pre>
          </div>
          <div class="run-code__block">
            <span>Windows PowerShell</span>
            <pre><code>cd ~\Documents\epub2web\my-book-site
py -m http.server 8000</code></pre>
          </div>
          <figcaption>
            Replace <code>my-book-site</code> with your folder name, then open{" "}
            <code>http://localhost:8000/</code>. Any static file server works.
          </figcaption>
        </figure>
      </div>

      <p class="run-site__note">
        <Icon name="alert" size={15} />
        <span>
          Opening <code>index.html</code> from your filesystem won't work: the
          site uses absolute links, and search needs <code>http://</code>.
        </span>
      </p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq__layout">
      <aside class="faq__aside">
        <p class="eyebrow">VI · Questions</p>
        <h2>Before you download.</h2>
        <p class="faq__intro">
          What people ask before downloading, including the security warning
          your computer may show the first time you open the app.
        </p>
        <div class="faq__warning-note">
          <Icon name="alert" size={17} />
          <p>
            <strong>Unsigned, not unsafe.</strong> The desktop builds do not have
            paid code-signing certificates yet. Only continue with a file from
            the official releases page.
          </p>
        </div>
      </aside>

      <div class="faq__list">
        <details class="faq-item faq-item--warning" id="first-launch" open>
          <summary>
            Why does Windows or macOS warn me when I open the app?
            <span class="faq-item__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq-item__answer">
            <p>
              Windows SmartScreen and macOS Gatekeeper may warn about an
              unidentified developer on first launch. That's expected because
              the desktop builds aren't code-signed yet. It doesn't mean the
              download was tampered with, but only continue if you downloaded it
              from the{" "}
              <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
                official GitHub releases page
              </a>.
            </p>

            <div class="warning-grid">
              <div class="warning-card">
                <h3><Icon name="windows" size={16} /> Windows</h3>
                <p>If “Windows protected your PC” appears:</p>
                <ol>
                  <li>Click <strong>More info</strong>.</li>
                  <li>Click <strong>Run anyway</strong>.</li>
                  <li>Open the app and choose your EPUB.</li>
                </ol>
                <p class="warning-card__note">
                  On a workplace or school PC, Smart App Control may block
                  unsigned apps entirely. Ask your administrator rather than
                  disabling security features.
                </p>
              </div>

              <div class="warning-card">
                <h3><Icon name="apple" size={16} /> macOS 15 and later</h3>
                <p>After dragging the app to Applications:</p>
                <ol>
                  <li>Try to open it once, then click <strong>Done</strong>.</li>
                  <li>
                    Open <strong>System Settings → Privacy &amp; Security</strong>.
                  </li>
                  <li>
                    Under <strong>Security</strong>, click{" "}
                    <strong>Open Anyway</strong>, then authenticate.
                  </li>
                  <li>Open the app again.</li>
                </ol>
                <p class="warning-card__note">
                  The Open Anyway button is available for about an hour after
                  the first attempt. On macOS 14 and earlier, right-click the
                  app and choose <strong>Open</strong>.
                </p>
              </div>
            </div>

            <p class="faq-item__fine">
              If macOS says the app is damaged, delete it, re-download from the
              official release, and try again. You can verify downloads against
              the SHA-256 checksums on the release page.{" "}
              <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">
                Full first-launch guide
              </a>.
            </p>
          </div>
        </details>

        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.question}
                <span class="faq-item__marker" aria-hidden="true" />
              </summary>
              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner">
      <span class="closing__watermark" aria-hidden="true">
        <Icon name="book" size={420} strokeWidth={0.8} />
      </span>
      <p class="eyebrow">VII · Get started</p>
      <h2>
        Make a web edition<br />
        <span class="accent">of your book.</span>
      </h2>
      <p class="closing__intro">
