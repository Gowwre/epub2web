---
import Icon from "./Icon.astro";
import { GITHUB_URL, withBase } from "../consts";
import {
  alternateLocale,
  getCopy,
  localeHref,
  localePath,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const copy = getCopy(locale);
const otherLocale = alternateLocale(locale);
const otherPath = localePath(otherLocale, path);
const otherCode = otherLocale === "vi" ? "VI" : "EN";

const navLinks = [
  { label: copy.common.nav.features, href: localeHref(locale, "/#features") },
  { label: copy.common.nav.fidelity, href: localeHref(locale, "/#fidelity") },
  { label: copy.common.nav.howItWorks, href: localeHref(locale, "/#how-it-works") },
  { label: copy.common.nav.changelog, href: localePath(locale, "/changelog/") },
  { label: copy.common.nav.faq, href: localeHref(locale, "/#faq") },
];
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href={localePath(locale, "/")}>
      <img class="brand-mark" src={withBase("/favicon.svg")} alt="" width="32" height="32" />
      <span class="brand-text">
        <span class="brand-name">epub2web</span>
      </span>
      <span class="sr-only">{copy.common.header.homeSuffix}</span>
    </a>

    <nav class="primary-nav" aria-label={copy.common.nav.primary}>
      {
        navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="icon-btn language-btn"
        href={otherPath}
        hreflang={otherLocale}
        lang={otherLocale}
        data-language-switch={otherLocale}
        aria-label={copy.common.switchLanguage}
        title={copy.common.switchLanguage}
      >
        <Icon name="globe" size={18} />
        <span class="language-code" aria-hidden="true">{otherCode}</span>
      </a>

      <a
        class="icon-btn github-btn"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.common.header.githubLabel}
        title={copy.common.header.githubTitle}
      >
        <Icon name="github" size={19} />
      </a>

      <button
        class="icon-btn theme-btn"
        type="button"
        data-theme-toggle
        aria-label={copy.common.header.themeLabel}
        title={copy.common.header.themeTitle}
      >
        <span class="theme-icon sun-icon"><Icon name="sun" size={18} /></span>
        <span class="theme-icon moon-icon"><Icon name="moon" size={18} /></span>
      </button>

      <a class="btn btn--primary btn--header" href={localePath(locale, "/download/")}>
        {copy.common.header.download}
        <Icon name="arrow-right" size={15} class="btn-arrow" />
      </a>
    </div>
  </div>
</header>

<script>
  const themeKey = "epub2web-landing-theme";
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLElement>("[data-theme-toggle]");

  const syncThemeState = () => {
    const isDark = root.dataset.theme === "dark";
    toggles.forEach((toggle) => {
      toggle.setAttribute("aria-pressed", String(isDark));
    });
  };

  syncThemeState();

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem(themeKey, next);
      } catch {
        // A theme preference is not worth breaking the page over.
      }
      syncThemeState();
    });
  });

  const languageKey = "epub2web-ui-lang";
  const languageLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]");

  const rememberLanguage = (event: Event) => {
    const link = event.currentTarget as HTMLAnchorElement | null;
    const language = link?.dataset.languageSwitch;
    if (language !== "en" && language !== "vi") return;
    try {
      localStorage.setItem(languageKey, language);
    } catch {
      // A language preference is not worth breaking the page over.
    }
  };

  languageLinks.forEach((link) => {
    link.addEventListener("click", rememberLanguage);
    link.addEventListener("auxclick", rememberLanguage);
  });
</script>
