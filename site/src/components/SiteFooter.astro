---
import Icon from "./Icon.astro";
import {
  CHANGELOG_URL,
  CONTRIBUTING_URL,
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  GUI_DOCS_URL,
  ISSUES_URL,
  LATEST_RELEASE_URL,
  LICENSE_URL,
  README_URL,
  withBase,
} from "../consts";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand brand--footer" href={withBase("/")}>
          <img class="brand-mark" src={withBase("/favicon.svg")} alt="" width="34" height="34" />
          <span class="brand-name">epub2web</span>
          <span class="sr-only">— home</span>
        </a>
        <p class="footer-tagline">
          A book you own, opened to the web. Static, searchable, and checked
          word for word.
        </p>
        <a class="footer-github" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          <span>View the project on GitHub</span>
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <nav class="footer-col" aria-label="Product">
        <h2>Product</h2>
        <ul>
          <li><a href={withBase("/download/")}>Download</a></li>
          <li><a href={DEMO_URL} target="_blank" rel="noopener noreferrer">Live demo</a></li>
          <li><a href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">Latest release</a></li>
          <li><a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer">Changelog</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Learn">
        <h2>Learn</h2>
        <ul>
          <li><a href={withBase("/#fidelity")}>The fidelity gate</a></li>
          <li><a href={withBase("/#first-launch")}>First-launch FAQ</a></li>
          <li><a href={README_URL} target="_blank" rel="noopener noreferrer">README</a></li>
          <li><a href={GUI_DOCS_URL} target="_blank" rel="noopener noreferrer">Desktop app docs</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Project">
        <h2>Project</h2>
        <ul>
          <li><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={ISSUES_URL} target="_blank" rel="noopener noreferrer">Report an issue</a></li>
          <li><a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">MIT license</a></li>
          <li><a href={CONTRIBUTING_URL} target="_blank" rel="noopener noreferrer">Contributing</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-base">
      <p>Open source under the MIT license. Your books remain yours.</p>
      <p>
        Set in Fraunces, Literata &amp; Inter · Built with{" "}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
        {" "}·{" "}
        <a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">First-launch notes</a>
      </p>
    </div>
  </div>
</footer>
