---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../Icon.astro";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  ISSUES_URL,
  LATEST_RELEASE_URL,
  README_URL,
  RELEASES_URL,
  withBase,
} from "../../consts";
import { getCopy, localeHref, localePath, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const home = copy.home;
const downloadHref = localePath(locale, "/download/");
const firstLaunchGuideHref = localeHref(locale, "/download/#first-launch");
const home720 = withBase("/screenshots/home-720.webp");
const home1440 = withBase("/screenshots/home-1440.webp");
const reading720 = withBase("/screenshots/reading-720.webp");
const reading1440 = withBase("/screenshots/reading-1440.webp");
const searchPanel = withBase("/screenshots/search-panel.webp");
---

<BaseLayout
  locale={locale}
  path="/"
  title={home.metaTitle}
  description={home.metaDescription}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <a class="launch-pill" href="#annotations">
          <span class="launch-pill__new">{home.hero.newBadge}</span>
          <span>{home.hero.launchPill}</span>
          <Icon name="arrow-right" size={13} class="launch-pill__arrow" />
        </a>

        <h1>
          {home.hero.titleLine1}<br />
          {home.hero.titleLine2Before}<span class="accent">{home.hero.titleLine2Accent}</span>
        </h1>

        <p class="hero__intro">{home.hero.intro}</p>

        <div class="hero__actions">
          <a class="btn btn--primary btn--large" href={downloadHref}>
            <Icon name="download" size={17} />
            {home.hero.downloadApp}
          </a>
          <a
            class="btn btn--quiet btn--large"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            {home.hero.openDemo}
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </div>

        <ul class="hero__meta" aria-label={home.hero.atAGlance}>
          {home.hero.meta.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <figure class="hero__visual">
        <div class="shot">
          <img
            src={home1440}
            srcset={`${home720} 720w, ${home1440} 1440w`}
            sizes="(max-width: 980px) 100vw, 46vw"
            width="1440"
            height="1000"
            alt={home.hero.imageAlt}
            fetchpriority="high"
          />
        </div>
        <figcaption class="shot-caption">{home.hero.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section fidelity" id="fidelity">
    <div class="container">
      <div class="fidelity__grid">
        <div class="fidelity__copy">
          <p class="eyebrow">{home.fidelity.eyebrow}</p>
          <h2>
            {home.fidelity.titleLine1}<br />
            <span class="accent">{home.fidelity.titleAccent}</span>
          </h2>
          <p class="lede">{home.fidelity.lede}</p>

          <ul class="fidelity__checks">
            {
              home.fidelity.checks.map((check) => (
                <li>
                  <span class="fidelity__check-label">
                    <Icon name="check" size={13} />
                    {check.label}
                  </span>
                  <p>{check.body}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="colophon">
          <div class="colophon__head">
            <div>
              <p class="colophon__kicker">{home.fidelity.colophon.kicker}</p>
              <h3>{home.fidelity.colophon.title}</h3>
            </div>
            <span class="status">
              <Icon name="check" size={13} />
              {home.fidelity.colophon.verified}
            </span>
          </div>

          <dl class="colophon__rows">
            {
              home.fidelity.colophon.rows.map((row) => (
                <div class="colophon__row">
                  <dt>{row.label}</dt>
                  <span class="colophon__dots" aria-hidden="true"></span>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>

          <figcaption>{home.fidelity.colophon.caption}</figcaption>
        </figure>
      </div>

      <p class="fidelity__failnote">
        <Icon name="shield" size={16} />
        <span>
          <strong>{home.fidelity.failStrong}</strong> {home.fidelity.failRest}
        </span>
      </p>
    </div>
  </section>

  <section class="section edition" id="features">
    <div class="container">
      <header class="section-intro">
        <p class="eyebrow">{home.edition.eyebrow}</p>
        <h2>
          {home.edition.titleLine1}<br />
          <span class="accent">{home.edition.titleAccent}</span>
        </h2>
        <p class="lede">{home.edition.lede}</p>
      </header>

      <div class="feature-grid">
        <article class="feature feature--reading">
          <h3>{home.edition.features.reading.title}</h3>
          <p>{home.edition.features.reading.body}</p>
          <figure class="feature__media">
            <img
              src={reading1440}
              srcset={`${reading720} 720w, ${reading1440} 1440w`}
              sizes="(max-width: 980px) 100vw, 56vw"
              width="1440"
              height="1000"
              alt={home.edition.features.reading.imageAlt}
              loading="lazy"
            />
            <figcaption class="feature__media-caption">
              {home.edition.features.reading.caption}
            </figcaption>
          </figure>
        </article>

        <article class="feature feature--search">
          <h3>{home.edition.features.search.title}</h3>
          <p>{home.edition.features.search.body}</p>
          <figure class="feature__media">
            <img
              src={searchPanel}
              width="640"
              height="480"
              alt={home.edition.features.search.imageAlt}
              loading="lazy"
            />
            <figcaption class="feature__media-caption">
              {home.edition.features.search.caption}
            </figcaption>
          </figure>
        </article>

        <article class="feature feature--file">
          <Icon name="folder" size={21} />
          <h3>{home.edition.features.keep.title}</h3>
          <p>{home.edition.features.keep.body}</p>
          <pre class="file-tree"><code><span class="tree-root">book-site/</span>
├── <span class="tree-file">index.html</span>
├── <span class="tree-file">read/1/index.html</span>
├── <span class="tree-dir">assets/</span>
└── <span class="tree-file">search-index.json</span></code></pre>
        </article>

        <article class="feature feature--book">
          <Icon name="book" size={21} />
          <h3>{home.edition.features.book.title}</h3>
          <p>{home.edition.features.book.body}</p>
          <ul class="tag-list">
            {home.edition.features.book.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>

        <article class="feature feature--a11y">
          <Icon name="keyboard" size={21} />
          <h3>{home.edition.features.a11y.title}</h3>
          <p>{home.edition.features.a11y.body}</p>
          <ul class="tag-list">
            {home.edition.features.a11y.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      </div>

      <p class="edition__link">
        <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          {home.edition.demo}
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="section annotations" id="annotations">
    <div class="container annotations__grid">
      <div class="annotations__copy">
        <p class="eyebrow">{home.annotations.eyebrow}</p>
        <h2>
          {home.annotations.titleLine1}<br />
          <span class="accent">{home.annotations.titleAccent}</span>
        </h2>
        <p class="lede">{home.annotations.lede}</p>

        <ul class="annotation-points">
          {
            home.annotations.points.map((point, index) => (
              <li>
                <Icon
                  name={["highlighter", "search", "download"][index] as "highlighter" | "search" | "download"}
                  size={18}
                />
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="annotations__more">
          <a class="text-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
            {home.annotations.demoLink}
            <Icon name="arrow-up-right" size={14} class="icon--external" />
          </a>
        </p>
      </div>

      <figure class="annotation-demo">
        <div class="annotation-demo__stage">
          <div class="annotation-demo__page">
            <p class="annotation-demo__kicker">{home.annotations.demo.kicker}</p>
            <h3>{home.annotations.demo.title}</h3>
            <p class="annotation-demo__text">
              {home.annotations.demo.firstText}<mark>{home.annotations.demo.markedText}</mark>
            </p>
            <p class="annotation-demo__text">{home.annotations.demo.secondText}</p>
          </div>

          <aside class="note-card" aria-label={home.annotations.demo.noteAria}>
            <div class="note-card__head">{home.annotations.demo.noteHead}</div>
            <blockquote>{home.annotations.demo.noteQuote}</blockquote>
            <p>{home.annotations.demo.noteBody}</p>
            <div class="note-card__foot">
              <span>{home.annotations.demo.copyMarkdown}</span>
              <span>{home.annotations.demo.exportJson}</span>
            </div>
          </aside>
        </div>
        <figcaption>{home.annotations.demo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="private" id="privacy">
    <div class="container private__grid">
      <div class="private__lead">
        <p class="eyebrow eyebrow--night">{home.privacy.eyebrow}</p>
        <h2>
          {home.privacy.titleLine1}<br />
          <span>{home.privacy.titleAccent}</span>
        </h2>
        <p class="private__lede">{home.privacy.lede}</p>
        <a
          class="btn btn--light"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} />
          {home.privacy.github}
        </a>
      </div>

      <ul class="private__points">
        {
          home.privacy.points.map((point, index) => (
            <li>
              <Icon name={["lock", "repeat", "code"][index] as "lock" | "repeat" | "code"} size={19} />
              <div>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section process" id="how-it-works">
    <div class="container">
      <header class="section-intro section-intro--center">
        <p class="eyebrow">{home.process.eyebrow}</p>
        <h2>
          {home.process.titleLine1}<br />
          <span class="accent">{home.process.titleAccent}</span>
        </h2>
        <p class="lede">{home.process.lede}</p>
      </header>

      <ol class="steps">
        {
          home.process.steps.map((step, index) => (
            <li class="step">
              <span class="step__num">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="process__cli">
        <span>{home.process.cliLabel}</span>
        <code>pipx install git+https://github.com/Gowwre/epub2web</code>
        <a class="text-link" href={README_URL} target="_blank" rel="noopener noreferrer">
          {home.process.docs}
          <Icon name="arrow-up-right" size={13} class="icon--external" />
        </a>
      </p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq__layout">
      <aside class="faq__aside">
        <p class="eyebrow">{home.faq.eyebrow}</p>
        <h2>{home.faq.title}</h2>
        <p class="faq__intro">{home.faq.intro}</p>
        <a
          class="text-link"
          href={ISSUES_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {home.faq.ask}
          <Icon name="arrow-up-right" size={14} class="icon--external" />
        </a>
      </aside>

      <div class="faq__list">
        <details class="faq-item faq-item--first" id="first-launch">
          <summary>
            {home.faq.first.summary}
            <span class="faq-item__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq-item__answer">
            <p>
              {home.faq.first.p1Before}<a
                href={RELEASES_URL}
                target="_blank"
                rel="noopener noreferrer"
              >{home.faq.first.p1Link}</a>{home.faq.first.p1After}
            </p>
            <p>
              {home.faq.first.p2Before}<a href={firstLaunchGuideHref}>
                {home.faq.first.p2GuideLink}
              </a>{home.faq.first.p2Mid}<a
                href={FIRST_LAUNCH_URL}
                target="_blank"
                rel="noopener noreferrer"
              >{home.faq.first.p2ReadmeLink}</a>{home.faq.first.p2After}
            </p>
          </div>
        </details>

        {
          home.faq.items.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.question}
                <span class="faq-item__marker" aria-hidden="true" />
              </summary>
              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner">
      <p class="eyebrow">{home.closing.eyebrow}</p>
      <h2>
        {home.closing.titleLine1}<br />
        <span class="accent">{home.closing.titleAccent}</span>
      </h2>
      <p class="closing__intro">{home.closing.intro}</p>
      <div class="closing__actions">
        <a class="btn btn--primary btn--large" href={downloadHref}>
          <Icon name="download" size={17} />
          {home.closing.download}
        </a>
        <a
          class="btn btn--quiet btn--large"
          href={DEMO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {home.closing.demo}
          <Icon name="arrow-up-right" size={15} class="btn-arrow" />
        </a>
      </div>
      <p class="closing__meta">
        {home.closing.meta}<a
          href={LATEST_RELEASE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >{home.closing.latestRelease}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------
     Hero
     ------------------------------------------------------------------ */

  .hero {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
  }

  .launch-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0.65rem 0.28rem 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.73rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .launch-pill__new {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .launch-pill__arrow {
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .launch-pill:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
  }

  .launch-pill:hover .launch-pill__arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .hero h1 {
    max-width: 12ch;
    margin-top: 1.35rem;
    font-size: clamp(3.2rem, 2.2rem + 3.8vw, 5.1rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
  }

  .hero__intro {
    max-width: 46ch;
    margin: 1.45rem 0 1.75rem;
    font-size: clamp(1.02rem, 0.98rem + 0.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.05rem;
    margin: 1.65rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .hero__meta li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__meta li + li::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .hero__visual {
    min-width: 0;
  }

  /* ------------------------------------------------------------------
     Shared section
     ------------------------------------------------------------------ */

  .section {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    border-top: 1px solid var(--rule);
  }

  .section-intro {
    max-width: 820px;
  }

  .section-intro h2 {
    max-width: 16ch;
    margin-top: 0.1rem;
    font-size: clamp(2.4rem, 1.7rem + 3vw, 4.3rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .section-intro .lede {
    margin-top: 1.2rem;
  }

  .section-intro--center {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .section-intro--center .eyebrow {
    justify-content: center;
  }

  .section-intro--center h2 {
    max-width: 24ch;
    margin-inline: auto;
  }

  .section-intro--center .lede {
    margin-inline: auto;
  }

  /* ------------------------------------------------------------------
     Fidelity
     ------------------------------------------------------------------ */

  .fidelity__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .fidelity__copy h2 {
    max-width: 18ch;
    margin-top: 0.1rem;
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .fidelity__copy .lede {
    max-width: 46ch;
    margin-top: 1.2rem;
  }

  .fidelity__checks {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .fidelity__checks li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .fidelity__check-label {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.12rem;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .fidelity__check-label .icon {
    color: var(--pass);
  }

  .fidelity__checks p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .fidelity__failnote {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .fidelity__failnote .icon {
    margin-top: 0.12rem;
    color: var(--pass);
  }

  .fidelity__failnote strong {
    color: var(--ink);
  }

  /* ------------------------------------------------------------------
     Colophon
     ------------------------------------------------------------------ */

  .colophon {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    margin: 0;
    padding: clamp(1.4rem, 2.8vw, 2rem);
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: var(--shadow-soft);
  }

  .colophon__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .colophon__kicker {
    margin: 0 0 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .colophon h3 {
    font-size: 1.35rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--pass) 35%, var(--rule));
    border-radius: 999px;
    background: var(--pass-soft);
    color: var(--pass);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .colophon__rows {
    margin: 0;
    padding: 0;
  }

  .colophon__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .colophon__row dt {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .colophon__dots {
    align-self: end;
    margin-bottom: 0.28em;
    border-bottom: 1px dotted var(--rule-strong);
  }

  .colophon__row dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    text-align: right;
  }

  .colophon figcaption {
    display: flex;
    align-items: center;
