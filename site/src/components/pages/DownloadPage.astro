---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../Icon.astro";
import release from "../../data/latest-release.json";
import {
  DEMO_URL,
  FIRST_LAUNCH_URL,
  GITHUB_URL,
  GUI_DOCS_URL,
  README_URL,
  RELEASES_URL,
} from "../../consts";
import { getCopy, localeHref, localePath, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.download;
const changelogHref = localePath(locale, "/changelog/");
const firstLaunchGuideHref = localeHref(locale, "/#first-launch");

function formatSize(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const published = new Intl.DateTimeFormat(locale === "vi" ? "vi-VN" : "en-US", {
  dateStyle: "medium",
  timeZone: "UTC",
}).format(new Date(release.publishedAt));

const platforms = [
  {
    key: "windows",
    name: "Windows",
    label: "Windows x64",
    variant: page.platforms.variants.windows,
    file: ".exe",
    hint: page.platforms.hints.windows,
    icon: "windows",
    guide: "windows",
    download: release.downloads.windows,
  },
  {
    key: "macosArm64",
    name: "macOS",
    label: "macOS Apple Silicon",
    variant: page.platforms.variants.macosArm64,
    file: ".dmg",
    hint: page.platforms.hints.macosArm64,
    icon: "apple",
    guide: "macos",
    download: release.downloads.macosArm64,
  },
  {
    key: "macosX64",
    name: "macOS",
    label: "macOS Intel",
    variant: page.platforms.variants.macosX64,
    file: ".dmg",
    hint: page.platforms.hints.macosX64,
    icon: "apple",
    guide: "macos",
    download: release.downloads.macosX64,
  },
  {
    key: "linux",
    name: "Linux",
    label: "Linux x86_64",
    variant: page.platforms.variants.linux,
    file: ".AppImage",
    hint: page.platforms.hints.linux,
    icon: "linux",
    guide: "linux",
    download: release.downloads.linux,
  },
] as const;

const firstLaunchGuides = {
  windows: {
    name: page.guides.windows.name,
    icon: "windows",
    steps: page.guides.windows.steps,
    note: page.guides.windows.note,
  },
  macos: {
    name: page.guides.macos.name,
    icon: "apple",
    steps: page.guides.macos.steps,
    note: page.guides.macos.note,
  },
  linux: {
    name: page.guides.linux.name,
    icon: "linux",
    steps: page.guides.linux.steps,
    note: page.guides.linux.note,
  },
} as const;

const versionMeta = page.hero.versionMeta.replace("{version}", release.version);
const releaseAria = page.hero.releaseAria.replace("{version}", release.version);
const fileSr = (filename: string) => page.platforms.fileSr.replace("{filename}", filename);
const downloadMessages = page.js;
---

<BaseLayout
  locale={locale}
  path="/download/"
  title={page.metaTitle}
  description={page.metaDescription}
  bodyClass="page-download"
>
  <section class="download-hero">
    <div class="container download-hero__grid">
      <div class="download-hero__copy">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1>
          {page.hero.titleLine1}<br />
          <span>{page.hero.titleAccent}</span>
        </h1>
        <p class="lede">{page.hero.lede}</p>
        <div class="download-hero__actions">
          <a
            class="btn btn--primary btn--large"
            href="#platforms"
            data-download-primary
          >
            <span data-download-icon="direct" hidden>
              <Icon name="download" size={18} />
            </span>
            <span data-download-icon="choose">
              <Icon name="arrow-down" size={15} />
            </span>
            <span data-download-label>{page.hero.choosePlatform}</span>
          </a>
          <a class="btn btn--quiet btn--large" href="#platforms" data-all-platforms hidden>
            {page.hero.allPlatforms}
            <Icon name="arrow-down" size={15} />
          </a>
        </div>
        <p class="download-hero__meta">{versionMeta}</p>
        <p
          class="download-hero__recommendation"
          data-download-recommendation
          aria-live="polite"
          hidden
        ></p>
      </div>

      <aside class="release-card" aria-label={releaseAria}>
        <div class="release-card__head">
          <span class="release-card__status">
            <span class="release-card__dot" aria-hidden="true"></span>
            {page.hero.latestRelease}
          </span>
          <span class="release-card__source">
            <Icon name="github" size={13} />
            {page.hero.github}
          </span>
        </div>
        <p class="release-card__title">epub2web {release.version}</p>
        <p class="release-card__desc">{page.hero.releaseDescription}</p>
        <dl class="release-card__specs">
          <div>
            <dt>{page.hero.specs.version}</dt>
            <dd>{release.version}</dd>
          </div>
          <div>
            <dt>{page.hero.specs.published}</dt>
            <dd>{published}</dd>
          </div>
          <div>
            <dt>{page.hero.specs.platforms}</dt>
            <dd>Windows · macOS · Linux</dd>
          </div>
          <div>
            <dt>{page.hero.specs.install}</dt>
            <dd>{page.hero.specs.none}</dd>
          </div>
        </dl>
        <a class="btn btn--quiet release-card__button" href={changelogHref}>
          {page.hero.releaseNotes}
          <Icon name="arrow-right" size={15} />
        </a>
        <p class="release-card__note">
          {page.hero.releaseNoteBefore}<a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">{page.hero.releaseNoteLink}</a>{page.hero.releaseNoteAfter}
        </p>
      </aside>
    </div>
  </section>

  <section class="section platforms" id="platforms" aria-labelledby="platforms-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{page.platforms.eyebrow}</p>
          <h2 id="platforms-title">
            {page.platforms.titleBefore}<span class="accent">{page.platforms.titleAccent}</span>
          </h2>
        </div>
        <p class="lede">{page.platforms.lede}</p>
      </div>

      <div class="platform-grid">
        {
          platforms.map((platform) => (
            <a
              class="platform-card"
              href={platform.download.url}
              data-platform={platform.key}
              data-platform-label={platform.label}
              data-platform-guide={platform.guide}
              data-download-platform={platform.key}
              data-download-filename={platform.download.filename}
              data-download-size={formatSize(platform.download.size)}
              title={`${platform.download.filename} (${formatSize(platform.download.size)})`}
            >
              <span class="sr-only">{page.platforms.downloadForSr}</span>
              <span class="platform-card__top">
                <span class="platform-card__icon">
                  <Icon name={platform.icon} size={20} />
                </span>
                <Icon name="download" size={16} class="platform-card__arrow" />
              </span>
              <span class="platform-card__badge" data-platform-badge hidden>
                {page.platforms.recommended}
              </span>
              <h3>{platform.name}</h3>
              <p class="platform-card__variant">{platform.variant}</p>
              <p class="platform-card__file">
                {platform.file} · {formatSize(platform.download.size)}
              </p>
              <p class="platform-card__hint">{platform.hint}</p>
              <span class="sr-only">{fileSr(platform.download.filename)}</span>
            </a>
          ))
        }
      </div>

      <p class="platforms__note">
        {page.platforms.noteBefore}<code>chmod +x epub2web-gui-*.AppImage</code>{page.platforms.noteMid}<code>--appimage-extract-and-run</code>{page.platforms.noteAfter}<a href={release.checksums.url}>SHA256SUMS.txt</a>{page.platforms.noteAfterLink}
      </p>
    </div>
  </section>

  <section class="launch-warning" id="first-launch" aria-labelledby="launch-warning-title">
    <div class="container">
      <div class="launch-warning__intro">
        <div>
          <p class="eyebrow">{page.launch.eyebrow}</p>
          <h2 id="launch-warning-title">{page.launch.title}</h2>
        </div>
        <div>
          <p>{page.launch.intro}</p>
          <a class="text-link" href={firstLaunchGuideHref}>
            {page.launch.readFaq}
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="warning-grid">
        <article class="warning-card">
          <h3><Icon name="windows" size={17} /> {page.launch.windowsTitle}</h3>
          <p>{page.launch.windowsLead}</p>
          <ol>
            {page.launch.windowsSteps.map((step) => <li set:html={step} />)}
          </ol>
          <p class="warning-card__fine">{page.launch.windowsFine}</p>
        </article>

        <article class="warning-card">
          <h3><Icon name="apple" size={17} /> {page.launch.macosTitle}</h3>
          <p>{page.launch.macosLead}</p>
          <ol>
            {page.launch.macosSteps.map((step) => <li set:html={step} />)}
          </ol>
          <p class="warning-card__fine">
            {page.launch.macosFineBefore}<strong>{page.launch.macosFineStrong}</strong><span set:html={page.launch.macosFineMid} />
          </p>
        </article>
      </div>

      <p class="launch-warning__fine">
        <Icon name="alert" size={15} />
        <span>
          {page.launch.verifyBefore}<a href={release.checksums.url}>SHA256SUMS.txt</a>{page.launch.verifyAfter}<a href={FIRST_LAUNCH_URL} target="_blank" rel="noopener noreferrer">{page.launch.verifyReadme}</a>{page.launch.verifyDocsMid}<a href={GUI_DOCS_URL} target="_blank" rel="noopener noreferrer">{page.launch.verifyDocs}</a>{page.launch.verifyDocsAfter}
        </span>
      </p>
    </div>
  </section>

  <section class="section other-ways" aria-labelledby="other-ways-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{page.other.eyebrow}</p>
          <h2 id="other-ways-title">{page.other.titleBefore}<span class="accent">{page.other.titleAccent}</span></h2>
        </div>
        <p class="lede">{page.other.lede}</p>
      </div>

      <div class="other-ways__grid">
        <article class="other-card">
          <p class="eyebrow">{page.other.sourceEyebrow}</p>
          <h3>{page.other.sourceTitle}</h3>
          <p>{page.other.sourceBody}</p>
          <pre class="install-code"><code>pipx install git+https://github.com/Gowwre/epub2web
epub2web book.epub --serve</code></pre>
          <a class="text-link" href={README_URL} target="_blank" rel="noopener noreferrer">
            {page.other.sourceLink}
            <Icon name="arrow-up-right" size={14} class="icon--external" />
          </a>
        </article>

        <article class="other-card other-card--demo">
          <p class="eyebrow">{page.other.demoTry}</p>
          <h3>{page.other.demoTitle}</h3>
          <p>{page.other.demoBody}</p>
          <a
            class="btn btn--quiet"
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            {page.other.demoButton}
            <Icon name="arrow-up-right" size={15} class="btn-arrow" />
          </a>
        </article>
      </div>

      <p class="other-ways__foot">
        {page.other.footBefore}<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">{page.other.footLink}</a>{page.other.footAfter}
      </p>
    </div>
  </section>

  <dialog
    class="launch-dialog"
    data-launch-dialog
    aria-labelledby="launch-dialog-title"
    aria-describedby="launch-dialog-desc"
  >
    <div class="launch-dialog__inner">
      <button
        type="button"
        class="icon-btn launch-dialog__close"
        data-launch-dialog-close
        aria-label={page.dialog.closeAria}
      >
        <Icon name="close" size={18} />
      </button>

      <p class="eyebrow launch-dialog__eyebrow">
        <span class="launch-dialog__status">
          <span class="launch-dialog__dot" aria-hidden="true"></span>
          {page.dialog.status}
        </span>
        <span class="launch-dialog__platform" data-launch-dialog-platform></span>
      </p>

      <h2 id="launch-dialog-title">{page.dialog.title}</h2>
      <p class="launch-dialog__desc" id="launch-dialog-desc">
        {page.dialog.description}<strong data-launch-dialog-name>{page.dialog.descriptionName}</strong>{page.dialog.descriptionAfter}
      </p>

      <p class="launch-dialog__file">
        <span data-launch-dialog-filename></span>
        <span data-launch-dialog-size></span>
      </p>

      <div class="launch-dialog__guide">
        {
          Object.entries(firstLaunchGuides).map(([key, guide]) => (
            <div data-launch-guide={key} hidden>
              <h3>
                <Icon name={guide.icon} size={16} />
                {page.dialog.onPlatform.replace("{platform}", guide.name)}
              </h3>
              <ol>
                {guide.steps.map((step) => (
                  <li set:html={step} />
                ))}
              </ol>
              <p class="launch-dialog__note" set:html={guide.note} />
            </div>
          ))
        }
      </div>

      <p class="launch-dialog__verify">
        <Icon name="lock" size={14} />
        <span>
          {page.dialog.verifyBefore}<a href={release.checksums.url}>SHA256SUMS.txt</a>{page.dialog.verifyAfter}
        </span>
      </p>

      <div class="launch-dialog__actions">
        <button type="button" class="btn btn--primary" data-launch-dialog-close>
          {page.dialog.gotIt}
        </button>
        <a
          class="text-link"
          href="#first-launch"
          data-launch-dialog-guide-link
        >
          {page.dialog.fullGuide}
          <Icon name="arrow-down" size={14} />
        </a>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="download-i18n" set:html={JSON.stringify(downloadMessages)}></script>

  <script>
    (async () => {
      interface UserAgentData {
        platform?: string;
        mobile?: boolean;
        getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }>;
      }

      interface DownloadMessages {
        yourComputer: string;
        choosePlatform: string;
        downloadFor: string;
        messages: Record<string, string>;
      }

      const messagesElement = document.getElementById("download-i18n");
      const messages: DownloadMessages = JSON.parse(messagesElement?.textContent || "{}");

      const primary = document.querySelector<HTMLAnchorElement>("[data-download-primary]");
      const primaryLabel = document.querySelector<HTMLElement>("[data-download-label]");
      const directIcon = document.querySelector<HTMLElement>('[data-download-icon="direct"]');
      const chooseIcon = document.querySelector<HTMLElement>('[data-download-icon="choose"]');
      const recommendation = document.querySelector<HTMLElement>(
        "[data-download-recommendation]",
      );
      const allPlatforms = document.querySelector<HTMLElement>("[data-all-platforms]");
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-platform]"));
      const launchDialog = document.querySelector<HTMLDialogElement>("[data-launch-dialog]");
      const launchPlatform = document.querySelector<HTMLElement>("[data-launch-dialog-platform]");
      const launchName = document.querySelector<HTMLElement>("[data-launch-dialog-name]");
      const launchFilename = document.querySelector<HTMLElement>("[data-launch-dialog-filename]");
      const launchSize = document.querySelector<HTMLElement>("[data-launch-dialog-size]");
      const launchGuides = Array.from(
        document.querySelectorAll<HTMLElement>("[data-launch-guide]"),
      );
      const launchCloseButtons = Array.from(
        document.querySelectorAll<HTMLElement>("[data-launch-dialog-close]"),
      );
      const launchGuideLink = document.querySelector<HTMLElement>(
        "[data-launch-dialog-guide-link]",
      );

      const downloadDataAttributes = [
        "data-download-platform",
        "data-platform-guide",
        "data-platform-label",
        "data-download-filename",
        "data-download-size",
      ] as const;

      const copyDownloadData = (from: HTMLAnchorElement, to: HTMLAnchorElement) => {
        for (const attribute of downloadDataAttributes) {
          const value = from.getAttribute(attribute);
          if (value === null) {
            to.removeAttribute(attribute);
          } else {
            to.setAttribute(attribute, value);
          }
        }
      };

      const closeLaunchGuide = () => {
        if (!launchDialog?.open) return;
        launchDialog.close();
      };

      const openLaunchGuide = (link: HTMLAnchorElement) => {
        if (!launchDialog || typeof launchDialog.showModal !== "function") return;

        const guide = launchGuides.find(
          (candidate) => candidate.dataset.launchGuide === link.dataset.platformGuide,
        );
        if (!guide) return;

        for (const panel of launchGuides) panel.hidden = panel !== guide;

        const label = link.dataset.platformLabel ?? messages.yourComputer;
        if (launchPlatform) launchPlatform.textContent = label;
        if (launchName) launchName.textContent = label;
        if (launchFilename) launchFilename.textContent = link.dataset.downloadFilename ?? "";
        if (launchSize) launchSize.textContent = link.dataset.downloadSize ?? "";

        document.documentElement.classList.add("has-dialog-open");
        if (!launchDialog.open) launchDialog.showModal();
      };

      for (const button of launchCloseButtons) {
        button.addEventListener("click", closeLaunchGuide);
      }

      launchGuideLink?.addEventListener("click", closeLaunchGuide);

      launchDialog?.addEventListener("click", (event) => {
        if (event.target === launchDialog) closeLaunchGuide();
      });

      launchDialog?.addEventListener("close", () => {
        document.documentElement.classList.remove("has-dialog-open");
      });

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>("a[data-download-platform]");
        if (link) openLaunchGuide(link);
      });

      const announce = (message: string) => {
        if (!recommendation) return;
        recommendation.textContent = message;
        recommendation.hidden = false;
      };

      const clearRecommendedCard = () => {
        for (const card of cards) {
          card.classList.remove("platform-card--recommended");
          card
            .querySelector<HTMLElement>("[data-platform-badge]")
            ?.setAttribute("hidden", "");
        }
      };

      const choosePlatform = (message: string) => {
        clearRecommendedCard();
        if (!primary || !primaryLabel) return;
        primary.href = "#platforms";
        primaryLabel.textContent = messages.choosePlatform;
        for (const attribute of downloadDataAttributes) {
          primary.removeAttribute(attribute);
        }
        directIcon?.setAttribute("hidden", "");
        chooseIcon?.removeAttribute("hidden");
        allPlatforms?.setAttribute("hidden", "");
        announce(message);
      };

      const recommend = (key: string, message: string) => {
        const card = cards.find((candidate) => candidate.dataset.platform === key);
        if (!card || !primary || !primaryLabel) {
          choosePlatform(messages.messages.fallbackChoose);
          return;
        }

        clearRecommendedCard();
        card.classList.add("platform-card--recommended");
        card.querySelector<HTMLElement>("[data-platform-badge]")?.removeAttribute("hidden");
        primary.href = card.href;
        copyDownloadData(card, primary);
        primaryLabel.textContent = messages.downloadFor.replace(
          "{platform}",
          card.dataset.platformLabel ?? messages.yourComputer,
        );
        directIcon?.removeAttribute("hidden");
        chooseIcon?.setAttribute("hidden", "");
        allPlatforms?.removeAttribute("hidden");
        announce(message);
      };

      const ua = navigator.userAgent;
      const uaData = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData;
      const touchMac =
        navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1;
      const isMobile =
        uaData?.mobile === true || /iPhone|iPad|iPod|Android/i.test(ua) || touchMac;
      const isChromeOS = /CrOS/i.test(ua);
      const isWindows = /Windows NT/i.test(ua);
      const isMac = /Macintosh|Mac OS X/i.test(ua);
      const isLinux = !isChromeOS && /Linux/i.test(ua);
      const uaLooksArm = /aarch64|arm64|armv\d|armhf/i.test(ua);

      let architecture = "";
      try {
        architecture =
          (
            await uaData?.getHighEntropyValues?.(["architecture"])
          )?.architecture?.toLowerCase() ?? "";
      } catch {
        // High-entropy client hints are optional; fall back to the UA string.
      }

      if (isMobile) {
        choosePlatform(messages.messages.mobile);
      } else if (isWindows) {
        recommend("windows", messages.messages.windows);
      } else if (isMac) {
        if (/x86|intel/i.test(architecture)) {
          recommend("macosX64", messages.messages.macIntel);
        } else if (/arm/i.test(architecture)) {
          recommend("macosArm64", messages.messages.macArm);
        } else {
          recommend("macosArm64", messages.messages.macUnknown);
        }
      } else if (isChromeOS) {
        choosePlatform(messages.messages.chromeos);
      } else if (isLinux) {
        if (/arm/i.test(architecture) || uaLooksArm) {
          choosePlatform(messages.messages.linuxArm);
        } else {
          recommend("linux", messages.messages.linux);
        }
      } else {
        choosePlatform(messages.messages.fallbackChoose);
      }
    })();
  </script>
</BaseLayout>

<style>
  .download-hero {
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .download-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .download-hero h1 {
    margin-top: 0.25rem;
    font-size: clamp(3.3rem, 2.2rem + 4vw, 5.5rem);
    line-height: 0.93;
    letter-spacing: -0.05em;
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
  }

  .download-hero h1 span {
    color: var(--accent);
  }

  .download-hero .lede {
    margin: 1.5rem 0 1.9rem;
  }

  .download-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .download-hero__meta {
    margin: 1.3rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .download-hero__recommendation {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.69rem;
    line-height: 1.55;
    color: var(--accent);
  }

  .download-hero__recommendation::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--accent);
  }

  .release-card {
    position: relative;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: var(--shadow-soft);
  }

  .release-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .release-card__status,
  .release-card__source {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .release-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

