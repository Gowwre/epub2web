{
  "name": "the-design-of-everyday-things-web",
  "private": true,
  "version": "0.1.0",
  "description": "A browser edition of The Design of Everyday Things, built from the EPUB with a deterministic extraction pipeline and a text-fidelity gate.",
  "scripts": {
    "extract": "python3 scripts/build_pipeline.py --only extract",
    "build": "python3 scripts/build_pipeline.py",
    "verify": "python3 scripts/build_pipeline.py --only verify",
    "links": "python3 scripts/build_pipeline.py --only links",
    "check": "python3 scripts/build_pipeline.py --links",
    "dev": "python3 -m http.server 4321 -d dist",
    "serve": "python3 -m http.server 4321 -d dist",
    "package:offline": "python3 scripts/build_pipeline.py --package",
    "lint": "ruff check epub2web scripts && ruff format --check epub2web scripts",
    "lint:js": "node --check static/assets/app.js && node --check epub2web/theme/assets/app.js",
    "theme:sync": "python3 scripts/sync_theme.py",
    "theme:check": "python3 scripts/sync_theme.py --check",
    "clean": "python3 scripts/clean.py"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
